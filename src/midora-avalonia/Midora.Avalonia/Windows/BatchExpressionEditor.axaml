<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.BatchExpressionEditor"
        x:CompileBindings="False"
        Title="Batch Edit Expression Editor"
        Width="680" Height="400" MinWidth="520" MinHeight="320"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Window.Styles>
    <!-- WPF Border.Style triggers: default / hover / keyboard-focus-within border. -->
    <Style Selector="Border#ExpressionChrome">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    </Style>
    <Style Selector="Border#ExpressionChrome:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="Border#ExpressionChrome:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
    </Style>
  </Window.Styles>
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,58">

      <!-- Custom title bar (WPF WindowChrome substitute). The WPF control had no title bar. -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Background="Transparent" PointerPressed="OnTitleBarPointerPressed" />
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   IsHitTestVisible="False" Text="Batch Edit Expression Editor" />
        <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCloseClick"
                ToolTip.Tip="Close">
          <controls:FluentIcon Classes="captionicon"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <!-- Editor layout, mirroring the hosting Batch Edit dialog. -->
      <ScrollViewer Grid.Row="1" Padding="14,12"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,12" Classes="muted" TextWrapping="Wrap" LineHeight="19"
                     Text="Leave a field blank to keep it unchanged. Type = to enable expression colors, bracket matching, and completion (Ctrl+Space)." />

          <!-- Expression mode: AvalonEdit TextEditor replaced by a monospace TextBox inside the WPF chrome. -->
          <Grid Margin="0,0,0,10" ColumnDefinitions="116,*">
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Velocity" />
            <Border x:Name="ExpressionChrome" Grid.Column="1" MinHeight="42"
                    Background="{DynamicResource Brush.Surface.0}"
                    BorderThickness="1" CornerRadius="3">
              <TextBox x:Name="VelocityBox" MinHeight="40" Padding="6,4"
                       Classes="mono" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                       Background="Transparent" BorderThickness="0" Foreground="#D4D4D4"
                       AcceptsReturn="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       KeyDown="OnExpressionKeyDown"
                       Text="=Clamp(v0 * 1.15, 1, 127)" />
            </Border>
          </Grid>

          <!-- Plain (non-expression) mode branch of the WPF control. -->
          <Grid Margin="0,0,0,10" ColumnDefinitions="116,*">
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Gate" />
            <TextBox x:Name="GateBox" Grid.Column="1" Classes="mono" MinHeight="34" Padding="7,5"
                     FontFamily="{DynamicResource Font.Mono}" AcceptsReturn="False"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" Text="*1.25" />
          </Grid>

          <!-- Hosting dialog toolbar. -->
          <WrapPanel Margin="116,0,0,10">
            <Button Width="86" Margin="0,0,6,6" Content="Help" />
            <Button Width="96" Margin="0,0,6,6" Content="Presets…" />
            <Button Width="112" Margin="0,0,6,6" Content="Save Preset…" />
            <Button Margin="0,0,6,6" Content="Show completion" Click="OnShowCompletionClick"
                    ToolTip.Tip="Demo trigger for the WPF caret-anchored completion popup" />
          </WrapPanel>

          <!-- Hosting dialog result bar. -->
          <Border Padding="9,7"
                  Background="{DynamicResource Brush.Surface.1}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1" CornerRadius="3">
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Validated: expression syntax is valid, all referenced variables are available, and there are no circular result dependencies." />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Completion popup, preserving the WPF ListBox + signature panel structure. -->
      <Popup x:Name="CompletionPopup" IsOpen="False" Placement="BottomEdgeAlignedLeft"
             IsLightDismissEnabled="True" HorizontalOffset="0" VerticalOffset="2">
        <Border MinWidth="440" MaxWidth="720" MaxHeight="270"
                Background="{DynamicResource Brush.Surface.2}"
                BorderBrush="{DynamicResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="4">
          <DockPanel LastChildFill="True">
            <Border x:Name="SignaturePanel" DockPanel.Dock="Bottom" Padding="8,6"
                    Background="{DynamicResource Brush.Surface.0}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0">
              <TextBlock x:Name="SignatureText" FontFamily="{DynamicResource Font.Mono}"
                         FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                         TextWrapping="Wrap" />
            </Border>
            <ListBox x:Name="CompletionList" Focusable="False" MaxHeight="210"
                     Background="{DynamicResource Brush.Surface.2}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnCompletionSelectionChanged"
                     DoubleTapped="OnCompletionDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="3,1" ColumnDefinitions="150,78,*">
                    <TextBlock FontFamily="{DynamicResource Font.Mono}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Margin="8,0"
                               Foreground="{DynamicResource Brush.Info}"
                               Text="{Binding Kind}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Popup>

      <!-- Footer buttons, mirroring the hosting Batch Edit dialog. -->
      <Border Grid.Row="2" Padding="12,11"
              Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0">
        <Grid>
          <Button Width="90" HorizontalAlignment="Left" Content="Validate" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="112" Margin="0,0,6,0" IsCancel="True" Content="Cancel"
                    Click="OnCloseClick" />
            <Button Classes="primary" Width="112" IsDefault="True" Content="Apply"
                    Click="OnCloseClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
