{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora manifest.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "magic",
    "fileFormatVersion",
    "minimumReadableVersion",
    "manifestSchemaVersion",
    "createdWithSoftwareVersion",
    "lastSavedWithSoftwareVersion",
    "files"
  ],
  "properties": {
    "magic": {
      "const": "midora-project"
    },
    "fileFormatVersion": {
      "type": "integer",
      "const": 1
    },
    "minimumReadableVersion": {
      "type": "integer",
      "const": 1
    },
    "manifestSchemaVersion": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "createdWithSoftwareVersion": {
      "$ref": "common-v1.schema.json#/$defs/requiredShortText"
    },
    "lastSavedWithSoftwareVersion": {
      "$ref": "common-v1.schema.json#/$defs/requiredShortText"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    }
  },
  "$defs": {
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {
          "$ref": "common-v1.schema.json#/$defs/relativePath"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "common-v1.schema.json#/$defs/sha256"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "embedded-resource"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "not": {
          "required": ["schemaVersion"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "core-json",
                  "settings-json",
                  "conductor-json",
                  "event-instrument-pb",
                  "event-instrument-usage-pb",
                  "logical-track-pb"
                ]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["schemaVersion"],
            "properties": {
              "schemaVersion": {
                "$ref": "common-v1.schema.json#/$defs/schemaVersion"
              }
            }
          }
        }
      ]
    }
  }
}
