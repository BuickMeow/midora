{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora project.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nextStableId",
    "metadataPath",
    "conductorTrackPath",
    "settings",
    "eventInstruments",
    "eventInstrumentUsages",
    "midiChannelRoots",
    "arrangementTracks"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "nextStableId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
    "metadataPath": { "const": "metadata.json" },
    "conductorTrackPath": { "const": "conductor-track.json" },
    "settings": { "$ref": "#/$defs/settingsPaths" },
    "eventInstruments": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectObject" }
    },
    "eventInstrumentUsages": {
      "type": "array",
      "items": { "$ref": "#/$defs/eventInstrumentUsage" }
    },
    "midiChannelRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectObject" }
    },
    "arrangementTracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/arrangementTrack" }
    }
  },
  "$defs": {
    "settingsPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "globalResetDefaults",
        "globalEventScopeDefaults"
      ],
      "properties": {
        "project": { "const": "settings/project-settings.json" },
        "globalResetDefaults": { "const": "settings/global-reset-defaults.json" },
        "globalEventScopeDefaults": { "const": "settings/global-event-scope-defaults.json" }
      }
    },
    "projectObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "nameSnapshot"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^(event-instruments/ei_|midi-channel-roots/mcr_)[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/requiredShortText" }
      }
    },
    "eventInstrumentUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "eventInstrumentId"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^event-instrument-usages/eiu_[1-9][0-9]*\\.pb$"
        },
        "eventInstrumentId": { "$ref": "common-v1.schema.json#/$defs/stableId" }
      }
    },
    "arrangementTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "nameSnapshot", "sharedGroupId"],
      "properties": {
        "kind": { "enum": ["logical-track", "pure-midi-track"] },
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^(logical-tracks/lt_|midi-tracks/mt_)[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/shortText" },
        "sharedGroupId": {
          "anyOf": [
            { "$ref": "common-v1.schema.json#/$defs/stableId" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
