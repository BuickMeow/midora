<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.AudioRenderDialog"
        x:CompileBindings="False"
        Title="Render Audio"
        Width="670" Height="620" MinWidth="610" MinHeight="550"
        FontFamily="{DynamicResource Font.UI}"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,58">

      <!-- Title bar: self-drawn caption with drag and close. -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}" PointerPressed="OnTitlePointerPressed">
        <TextBlock Margin="12,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Render Audio" TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="36" HorizontalAlignment="Right"
                Classes="caption close" ToolTip.Tip="Close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                                 Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="18" ColumnDefinitions="*,14,*">
        <StackPanel>
          <TextBlock Classes="overline" Text="OUTPUT" />
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="MODE" />
          <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged" />
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="TARGET FILE / DIRECTORY" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="OutputPathBox" IsReadOnly="True" />
            <Button Grid.Column="1" Width="78" Margin="6,0,0,0" Content="Browse…" Click="OnBrowseClick" />
          </Grid>
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="SAMPLE RATE (HZ)" />
          <TextBox x:Name="SampleRateBox" Text="48000" />
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="MAXIMUM SAMPLE VOICES / UNIT STREAM" />
          <TextBox x:Name="VoicesBox" Text="500" />
          <CheckBox x:Name="WarningsCheck" Margin="0,14,0,0" Content="Treat compiler warnings as errors" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Classes="overline" Text="RANGE" />
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="START TICK" />
          <TextBox x:Name="StartTickBox" Text="0" />
          <TextBlock Margin="0,10,0,4" Classes="caption" Text="END TICK (EMPTY = PROJECT / NATURAL END)" />
          <TextBox x:Name="EndTickBox" />
          <Border Margin="0,16,0,0"
                  Padding="{DynamicResource Thickness.CardPadding}"
                  Background="{DynamicResource Brush.Surface.1}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Medium}">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Formal render chain" />
              <TextBlock Margin="0,5,0,0" Classes="caption" TextWrapping="Wrap"
                         Text="Canonical compiled result → isolated win-x64 Native AOT audio worker → per-Port sum → Playback Master Volume → Limiter → atomic float32 WAVE publication. At least one enabled application SoundFont and the pinned worker/native baseline are required." />
            </StackPanel>
          </Border>
          <CheckBox x:Name="SelectedTracksCheck" Margin="0,14,0,5" Content="Use only the checked Tracks" />
          <ListBox x:Name="TrackListBox" MaxHeight="145" ItemsSource="{Binding TrackRows}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ValidationText" Margin="0,12,0,0"
                     Foreground="{DynamicResource Brush.Red.Hover}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Padding="10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Width="112" Margin="0,0,7,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
          <Button Classes="primary" Width="112" Content="Review Plan" IsDefault="True" Click="OnReviewClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
