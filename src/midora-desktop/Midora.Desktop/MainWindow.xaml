                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource PropertyLabel}" Text="LOOP END TICK"/><TextBox Text="{Binding LoopEndText, Mode=TwoWay}"/></StackPanel>
                    <Button Grid.Column="3" Margin="8,18,0,0" Content="Apply Loop" Click="OnApplyInstrumentLoopClick"/>
                  </Grid>
                  <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="SCENARIO PREVIEW"/>
                    <UniformGrid Margin="0,8,0,7" Columns="4">
                      <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource PropertyLabel}" Text="GATE LENGTH"/><TextBox Text="{Binding ScenarioGateLengthTicks, Mode=TwoWay}"/></StackPanel>
                      <StackPanel Margin="6,0"><TextBlock Style="{StaticResource PropertyLabel}" Text="PITCH"/><TextBox Text="{Binding ScenarioPitch, Mode=TwoWay}"/></StackPanel>
                      <StackPanel Margin="6,0"><TextBlock Style="{StaticResource PropertyLabel}" Text="VELOCITY"/><TextBox Text="{Binding ScenarioVelocity, Mode=TwoWay}"/></StackPanel>
                      <StackPanel Margin="6,0,0,0"><TextBlock Style="{StaticResource PropertyLabel}" Text="HARD BOUNDARY"/><TextBox IsEnabled="{Binding ScenarioHasHardBoundary}" Text="{Binding ScenarioHardBoundaryTick, Mode=TwoWay}"/></StackPanel>
                    </UniformGrid>
                    <CheckBox Margin="0,0,0,7" Content="Use optional hard boundary" IsChecked="{Binding ScenarioHasHardBoundary, Mode=TwoWay}"/>
                    <GroupBox Style="{StaticResource RenderedSurfaceHost}" AutomationProperties.Name="Lifecycle scenario preview"><ui:LifecyclePreviewSurface TemplateLengthTicks="{Binding TemplateLengthTicks}" GateLengthTicks="{Binding ScenarioGateLengthTicks}" LoopStartTick="{Binding LoopStartTick}" LoopEndTick="{Binding LoopEndTick}" HasHardBoundary="{Binding ScenarioHasHardBoundary}" HardBoundaryTick="{Binding ScenarioHardBoundaryTick}" RequiresIsolation="{Binding RequiresChannelIsolation}" ScenarioPitch="{Binding ScenarioPitch}" ScenarioVelocity="{Binding ScenarioVelocity}"/></GroupBox>
                  </StackPanel></Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
        <Border Grid.Row="2" Padding="10,5" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="HELD PREVIEW · FORMAL CANONICAL PIPELINE" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal"><ComboBox Width="145" Height="24" Margin="0,0,5,0" ItemsSource="{Binding PreviewModeLabels}" SelectedIndex="{Binding PreviewModeIndex}" ToolTip="Full Instrument or Selected SubVoice preview"/><ToggleButton Height="24" Margin="0,0,4,0" Content="Mute" IsChecked="{Binding IsPreviewMuted}" ToolTip="Suppress this Workspace's preview task only"/><ToggleButton Height="24" Margin="0,0,5,0" Content="Solo Selected" IsChecked="{Binding IsPreviewSoloSelected}" ToolTip="Preview only the active SubVoice"/><ToggleButton Width="28" Height="24" Padding="0" IsChecked="{Binding IsPreviewExpanded}" ToolTip="Collapse or expand Preview"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Content" Value="▾"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="▴"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton></StackPanel></Grid><GroupBox Grid.Row="1" Height="72" Margin="0,5,0,0" AutomationProperties.Name="Virtual preview keyboard"><GroupBox.Style><Style TargetType="GroupBox" BasedOn="{StaticResource RenderedSurfaceHost}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPreviewExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></GroupBox.Style><ui:PianoKeyboardSurface StartNote="48" NoteCount="37" NotePressed="OnPreviewNotePressed" NoteReleased="OnPreviewNoteReleased"/></GroupBox></Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MappingFunctionWorkspaceViewModel}">
      <Grid Background="{StaticResource Brush.Surface.0}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Padding="12,10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource PropertyLabel}" Text="FUNCTION NAME"/><TextBox Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource PropertyLabel}" Text="DECLARED ABI V2 CONTEXT FIELDS"/><TextBox ToolTip="Comma-separated MappingContextV2 field names" Text="{Binding DeclaredContextFields, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Grid.Column="3" Margin="12,18,0,0" Orientation="Horizontal"><Button Margin="0,0,5,0" Content="Compile Draft" Click="OnCompileMappingDraftClick"/><Button Style="{StaticResource Button.Primary}" Content="Apply" IsEnabled="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Click="OnApplyMappingDraftClick"/></StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Padding="10,4" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Tag="MappingFind" Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find in Function (Ctrl+F)"/><Button Grid.Column="1" Margin="5,0,0,0" Height="24" Content="Find Next" Click="OnFindMappingClick"/><TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding FindStatus}"/></Grid></Border>
        <TextBox Grid.Row="2" Margin="10" Padding="12" AcceptsReturn="True" AcceptsTab="True"
                 Tag="MappingEditor"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 Text="{Binding DraftBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="OnMappingEditorSelectionChanged"/>
        <Border Grid.Row="3" Padding="10,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
          <Grid><TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Status}"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Margin="0,0,14,0" Style="{StaticResource Text.Caption}" Text="{Binding CaretStatus}"/><TextBlock Style="{StaticResource Text.Caption}" Text="Draft is session UI state until Apply succeeds."/></StackPanel></Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SettingsWorkspaceViewModel}">
      <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="IsEnabled" Value="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></Style></Grid.Resources>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <Border Margin="0,0,0,12" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="GENERAL AND METADATA"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding GeneralFields}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Style="{StaticResource Text.Overline}" Text="PROJECT SOUNDFONT"/>
              <TextBlock Margin="0,8,0,0" Text="{Binding SoundFont}" TextWrapping="Wrap"/>
              <StackPanel Margin="0,10,0,0" Orientation="Horizontal"><Button Margin="0,0,5,0" Content="Embed…" Click="OnSelectEmbeddedSoundFontClick"/><Button Margin="0,0,5,0" Content="Use External…" Click="OnSelectExternalSoundFontClick"/><Button Style="{StaticResource Button.Ghost}" Content="Clear" Click="OnClearSoundFontClick"/></StackPanel>
              <TextBlock Margin="0,10,0,0" Text="No SoundFont is a legal Project state. It disables preview, playback, and audio render only." TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSoundFont}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel></Border>
            <Border Margin="0,12,0,0" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="PROJECT INITIAL MIDI STATE"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding InitialStateFields}"/>
