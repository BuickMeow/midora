<Window x:Class="Midora.Desktop.MidiStateEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Add MIDI State Entry" Width="430" Height="370" MinHeight="370" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Surface.0}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
    <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown"><TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Add MIDI State Entry"/><Button Width="46" Height="38" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button></Grid>
    <StackPanel Grid.Row="1" Margin="18">
      <TextBlock Style="{StaticResource Text.Caption}" Text="Adds one explicit CC, RPN, or NRPN state value. Clear the resulting field later to remove it." TextWrapping="Wrap"/>
      <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.Overline}" Text="TARGET KIND"/>
      <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged"/>
      <TextBlock x:Name="NumberLabel" Margin="0,12,0,4" Style="{StaticResource Text.Overline}" Text="CONTROLLER"/>
      <ComboBox x:Name="ControllerBox" DisplayMemberPath="DisplayName"/>
      <TextBox x:Name="NumberBox" Visibility="Collapsed" Text="1"/>
      <TextBlock Margin="0,12,0,4" Style="{StaticResource Text.Overline}" Text="VALUE"/>
      <TextBox x:Name="ValueBox" Text="0"/>
      <TextBlock x:Name="ValidationText" Margin="0,9,0,0" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="2" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="82" Margin="0,0,7,0" Content="Cancel" IsCancel="True" Click="OnCancelClick"/><Button Width="82" Style="{StaticResource Button.Primary}" Content="Add" IsDefault="True" Click="OnAddClick"/></StackPanel></Border>
  </Grid></Border>
</Window>
