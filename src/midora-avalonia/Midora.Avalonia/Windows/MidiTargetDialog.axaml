<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.MidiTargetDialog"
        x:CompileBindings="False"
        Title="Select MIDI Target" Width="500" Height="340" MinHeight="340"
        FontFamily="{DynamicResource Font.UI}"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="38,*,58">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}"
            PointerPressed="OnTitleBarPointerPressed">
        <TextBlock x:Name="DialogTitleText" Margin="12,0,50,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" Text="Select MIDI Target" TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="38" HorizontalAlignment="Right" Classes="caption close"
                ToolTip.Tip="Close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="18">
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Select a non-Note MIDI or advanced value target. CC91 and CC93 are rejected by the initial-release profile." />
        <TextBlock Margin="0,14,0,4" Classes="overline" Text="TARGET KIND" />
        <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged" />
        <TextBlock x:Name="NumberLabel" Margin="0,12,0,4" Classes="overline" Text="CONTROLLER" />
        <ComboBox x:Name="ControllerBox" />
        <TextBox x:Name="NumberBox" IsVisible="False" Text="0" />
        <TextBlock x:Name="ValidationText" Margin="0,10,0,0"
                   Foreground="{DynamicResource Brush.Red.Hover}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Padding="10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,7,0" Content="Cancel" Click="OnCancelClick" />
          <Button Classes="primary" Content="Select" Click="OnSelectClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
