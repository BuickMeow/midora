<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.ParameterMappingPropertiesDialog"
        x:CompileBindings="False"
        Title="Parameter Mapping Properties"
        Width="580" Height="520" MinHeight="500"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="38,*,58">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Name="TitleBarDragSurface" Background="Transparent" PointerPressed="OnTitlePointerPressed"/>
        <TextBlock x:Name="DialogTitleText" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Parameter Mapping Properties"/>
        <Button Width="46" Height="38" HorizontalAlignment="Right" Classes="caption close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Classes="overline" Text="LOGICAL PARAMETER SOURCE"/>
          <ComboBox x:Name="SourceBox" Margin="0,4,0,14" DisplayMemberBinding="{Binding Label}"/>

          <TextBlock Classes="overline" Text="TARGET SUBVOICE"/>
          <ComboBox x:Name="SubVoiceBox" Margin="0,4,0,14" DisplayMemberBinding="{Binding Label}"/>

          <TextBlock Classes="overline" Text="TARGET EVENT KIND"/>
          <ComboBox x:Name="KindBox" Margin="0,4,0,14" SelectionChanged="OnKindChanged"/>

          <StackPanel x:Name="ControllerRow" Margin="0,0,0,14">
            <TextBlock Classes="overline" Text="CONTROLLER"/>
            <ComboBox x:Name="ControllerBox" Margin="0,4,0,0" DisplayMemberBinding="{Binding DisplayName}"/>
          </StackPanel>
          <StackPanel x:Name="RpnRow" Margin="0,0,0,14" IsVisible="False">
            <TextBlock Classes="overline" Text="RPN"/>
            <TextBox x:Name="RpnBox" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel x:Name="NrpnRow" Margin="0,0,0,14" IsVisible="False">
            <TextBlock Classes="overline" Text="NRPN"/>
            <TextBox x:Name="NrpnBox" Margin="0,4,0,0"/>
          </StackPanel>

          <TextBlock Margin="0,2,0,6" Classes="section" Text="Integer Target Settings"/>
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel>
              <TextBlock Classes="overline" Text="ROUNDING"/>
              <ComboBox x:Name="RoundingBox" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="overline" Text="OVERFLOW"/>
              <ComboBox x:Name="OverflowBox" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="ValidationText" Margin="0,14,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Red.Hover}"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,7,0" Width="112" IsCancel="True" Content="Cancel" Click="OnCancelClick"/>
          <Button Classes="primary" Width="112" IsDefault="True" Content="OK" Click="OnOkClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
