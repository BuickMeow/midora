<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.SplitNotesDialog"
        x:CompileBindings="False"
        Title="Split Notes"
        Width="690" Height="500" MinWidth="610" MinHeight="450" MaxHeight="760"
        FontFamily="{DynamicResource Font.UI}"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        KeyDown="OnDialogKeyDown">
  <Window.Styles>
    <!-- WPF BatchExpressionEditor expression chrome: default / hover / focus-within border. -->
    <Style Selector="Border.expression">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
    </Style>
    <Style Selector="Border.expression:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="Border.expression:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Red}" />
    </Style>
  </Window.Styles>
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,64">

      <!-- Custom title bar (WPF WindowChrome substitute). -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Background="Transparent" PointerPressed="OnTitlePointerPressed" />
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   IsHitTestVisible="False" Text="Split Notes" TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="36" HorizontalAlignment="Right" Classes="caption close"
                ToolTip.Tip="Close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Padding="16,14"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,14" Classes="muted" TextWrapping="Wrap"
                     Text="Knives are generated across the full selected time span and then applied to every selected note they cross." />

          <Grid Margin="0,0,0,13" ColumnDefinitions="170,*">
            <TextBlock VerticalAlignment="Center" Text="Split Mode" />
            <ComboBox x:Name="ModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnModeChanged">
              <ComboBoxItem Content="Fixed Piece Length" />
              <ComboBoxItem Content="Maximum Piece Count" />
              <ComboBoxItem Content="Expression" />
            </ComboBox>
          </Grid>

          <Grid x:Name="FixedLengthRow" Margin="0,0,0,13" ColumnDefinitions="170,*,48">
            <TextBlock VerticalAlignment="Center" Text="Piece Length" />
            <TextBox x:Name="FixedLengthBox" Grid.Column="1" Text="192" TextChanged="OnInputChanged" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="Ticks" />
          </Grid>

          <Grid x:Name="PieceCountRow" Margin="0,0,0,13" ColumnDefinitions="170,*" IsVisible="False">
            <TextBlock VerticalAlignment="Center" Text="Maximum Piece Count" />
            <TextBox x:Name="PieceCountBox" Grid.Column="1" Text="2" TextChanged="OnInputChanged" />
          </Grid>

          <Grid x:Name="ExpressionRow" Margin="0,0,0,13" ColumnDefinitions="170,*" IsVisible="False">
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Piece Length Expression" />
            <Border Grid.Column="1" Classes="expression" MinHeight="42"
                    Background="{DynamicResource Brush.Surface.0}"
                    BorderThickness="1" CornerRadius="3">
              <!-- Avalonia has no inline BatchExpressionEditor control; the ported editor is a Window,
                   so the expression branch is shown as a monospace TextBox inside the WPF chrome. -->
              <TextBox x:Name="ExpressionBox" MinHeight="40" Padding="6,4"
                       Classes="mono" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                       Background="Transparent" BorderThickness="0" Foreground="#D4D4D4"
                       AcceptsReturn="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       Text="=192" TextChanged="OnInputChanged" KeyDown="OnExpressionKeyDown" />
            </Border>
          </Grid>

          <Grid x:Name="MaximumCutsRow" Margin="0,0,0,13" ColumnDefinitions="170,*" IsVisible="False">
            <TextBlock VerticalAlignment="Center" Text="Maximum Cuts" />
            <TextBox x:Name="MaximumCutsBox" Grid.Column="1" Text="65535" TextChanged="OnInputChanged" />
          </Grid>

          <WrapPanel Margin="170,0,0,10">
            <Button Width="86" Margin="0,0,6,6" Content="Help" Click="OnHelpClick" />
            <Button Width="96" Margin="0,0,6,6" Content="Presets…" Click="OnPresetsClick" />
            <Button Width="112" Margin="0,0,6,6" Content="Save Preset…" Click="OnSavePresetClick" />
          </WrapPanel>

          <Border Padding="9,7" Background="{DynamicResource Brush.Surface.1}"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="ValidationText" Classes="caption" Text="Not validated." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="12,11" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Width="90" HorizontalAlignment="Left" Content="Validate" Click="OnValidateClick" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="112" Margin="0,0,6,0" IsCancel="True" Content="Cancel" Click="OnCancelClick" />
            <Button Classes="primary" Width="112" IsDefault="True" Content="Apply" Click="OnApplyClick" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
