                    ToolTip="{Binding PrimaryTransportToolTip}"
                    IsEnabled="{Binding CanTogglePlayback}" Click="OnPrimaryTransportClick">
              <Grid>
                <ui:FluentIcon Width="14" Height="14" Margin="1,0,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Data="{StaticResource Fluent.Play20Filled}">
                  <ui:FluentIcon.Style><Style TargetType="ui:FluentIcon" BasedOn="{StaticResource Icon.CommandBar}"><Style.Triggers><DataTrigger Binding="{Binding IsPlaybackActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ui:FluentIcon.Style>
