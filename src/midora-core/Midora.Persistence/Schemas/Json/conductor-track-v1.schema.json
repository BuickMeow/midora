{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora conductor-track.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tempos", "timeSignatures", "keySignatures", "markers"],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "tempos": { "type": "array", "items": { "$ref": "#/$defs/tempo" } },
    "timeSignatures": { "type": "array", "items": { "$ref": "#/$defs/timeSignature" } },
    "keySignatures": { "type": "array", "items": { "$ref": "#/$defs/keySignature" } },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "endMarker": { "$ref": "#/$defs/endMarker" }
  },
  "$defs": {
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tick", "beatsPerMinute"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "tick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "beatsPerMinute": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "timeSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tick", "numerator", "denominator"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "tick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "numerator": { "type": "integer", "minimum": 1, "maximum": 99 },
        "denominator": { "enum": [1, 2, 4, 8, 16, 32, 64] }
      }
    },
    "keySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tick", "sharpsFlats", "isMinor"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "tick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "sharpsFlats": { "type": "integer", "minimum": -7, "maximum": 7 },
        "isMinor": { "type": "boolean" }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tick", "name"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "tick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "name": { "$ref": "common-v1.schema.json#/$defs/shortText" }
      }
    },
    "endMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tick"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "tick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    }
  }
}
