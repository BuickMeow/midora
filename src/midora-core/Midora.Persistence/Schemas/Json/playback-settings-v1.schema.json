{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora settings/playback-settings.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "masterVolumeDecibels", "limiterEnabled", "stopCursorBehavior"],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "masterVolumeDecibels": {
      "type": "number",
      "minimum": -3.4028234663852886e38,
      "maximum": 0
    },
    "limiterEnabled": { "type": "boolean" },
    "stopCursorBehavior": {
      "enum": ["return-to-playback-start", "stay-at-stopped-tick"]
    }
  }
}
