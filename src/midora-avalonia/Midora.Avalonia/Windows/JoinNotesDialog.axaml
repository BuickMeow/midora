<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.JoinNotesDialog"
        x:CompileBindings="False"
        Title="Join Notes"
        Width="480" Height="245" MinWidth="430" MinHeight="225"
        FontFamily="{DynamicResource Font.UI}"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,62">

      <!-- Title bar: self-drawn caption with drag and close. -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}" PointerPressed="OnTitlePointerPressed">
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Join Notes" TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="36" HorizontalAlignment="Right" Classes="caption close"
                ToolTip.Tip="Close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,14">
        <TextBlock Margin="0,0,0,13" Classes="muted" TextWrapping="Wrap"
                   Text="Join each transitive run of selected notes that shares a Key. Unselected notes are not changed." />
        <Grid ColumnDefinitions="166,*,48">
          <TextBlock VerticalAlignment="Center" Text="Maximum Gap" />
          <TextBox x:Name="MaximumGapBox" Grid.Column="1" Text="0" TextChanged="OnInputChanged" />
          <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="Ticks" />
        </Grid>
        <TextBlock x:Name="ValidationText" Margin="166,9,0,0" Classes="caption"
                   Foreground="{DynamicResource Brush.Red.Hover}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Width="112" Margin="0,0,6,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
          <Button Classes="primary" Width="112" Content="Apply" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
