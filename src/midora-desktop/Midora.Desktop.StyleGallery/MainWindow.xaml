<Window x:Class="Midora.Desktop.StyleGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Midora — WPF Style Gallery"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="{StaticResource Brush.Surface.0}"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        mc:Ignorable="d">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="Panel.Header" TargetType="Border">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Status.Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Timeline.TrackHeader" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Brush.Surface.2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="Timeline.Lane" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Brush.Surface.0}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Piano.WhiteKey" TargetType="Border">
      <Setter Property="Background" Value="#D9DCE0" />
      <Setter Property="BorderBrush" Value="#8A9098" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Piano.BlackKey" TargetType="Border">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="#111318" />
      <Setter Property="BorderBrush" Value="#030405" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
  </Window.Resources>

  <Border x:Name="WindowFrame">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                       Value="Maximized">
            <Setter Property="BorderThickness" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="30" />
        <RowDefinition Height="48" />
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>

      <!-- Custom title bar -->
      <Grid Grid.Row="0"
            Background="{StaticResource Brush.Black}"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
            MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
          <Grid Width="18" Height="18" Margin="0,0,9,0">
            <Border Width="5" Height="18" HorizontalAlignment="Left" Background="{StaticResource Brush.Red}" CornerRadius="1" />
            <Border Width="5" Height="12" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource Brush.Red.Dark}" CornerRadius="1" />
            <Border Width="5" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource Brush.Text.Tertiary}" CornerRadius="1" />
          </Grid>
          <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="MIDORA" />
          <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border.Strong}" />
          <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Text="WPF STYLE GALLERY  /  STATIC PREVIEW" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    Orientation="Horizontal">
          <Button Style="{StaticResource Button.Caption}"
                  ToolTip="Minimize"
                  Click="OnMinimizeClick">
            <ui:FluentIcon Style="{StaticResource Icon.WindowControl.Minimize}"
                           Data="{StaticResource WindowControl.Minimize}" />
          </Button>
          <Button Style="{StaticResource Button.Caption}"
                  ToolTip="Maximize or restore"
                  Click="OnMaximizeClick">
            <ui:FluentIcon x:Name="MaximizeGlyph"
                           Style="{StaticResource Icon.WindowControl}"
                           Data="{StaticResource WindowControl.Maximize}" />
          </Button>
          <Button Style="{StaticResource Button.Caption.Close}"
                  ToolTip="Close"
                  Click="OnCloseClick">
            <ui:FluentIcon Style="{StaticResource Icon.WindowControl}"
                           Data="{StaticResource WindowControl.Close}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Main menu -->
      <Border Grid.Row="1"
              Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="0,0,0,1">
        <Menu shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="6,0">
          <MenuItem Header="File">
            <MenuItem Header="New Project" InputGestureText="Ctrl+N" />
            <MenuItem Header="Open Project…" InputGestureText="Ctrl+O" />
            <Separator />
            <MenuItem Header="Save Project" InputGestureText="Ctrl+S" />
            <MenuItem Header="Save Copy…" />
            <Separator />
            <MenuItem Header="Exit" />
          </MenuItem>
          <MenuItem Header="Edit">
            <MenuItem Header="Undo" InputGestureText="Ctrl+Z" />
            <MenuItem Header="Redo" InputGestureText="Ctrl+Y" />
          </MenuItem>
          <MenuItem Header="View" />
          <MenuItem Header="Project" />
          <MenuItem Header="Playback">
            <MenuItem Header="Play" InputGestureText="Space" />
            <MenuItem Header="Stop" InputGestureText="Shift+Space" />
            <Separator />
            <MenuItem Header="Reset Playback Engine" />
          </MenuItem>
          <MenuItem Header="Compile" />
          <MenuItem Header="Export" />
          <MenuItem Header="Help" />
        </Menu>
      </Border>

      <!-- Command and transport bar -->
      <Border Grid.Row="2"
              Padding="10,0"
              Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Button Style="{StaticResource Button.Icon}" ToolTip="New Project">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Add20Regular}" />
            </Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Save Project">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Save20Regular}" />
            </Button>
            <Border Width="1" Height="20" Margin="8,0" Background="{StaticResource Brush.Border}" />
            <Button Style="{StaticResource Button.Icon}" ToolTip="Undo">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowUndo20Regular}" />
            </Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Redo" IsEnabled="False">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowRedo20Regular}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Width="34" Style="{StaticResource Button.Icon}" ToolTip="Stop">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Stop20Filled}" />
            </Button>
            <Button Width="40" Margin="5,0" Style="{StaticResource Button.Primary}" ToolTip="Play">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Foreground="White" Data="{StaticResource Fluent.Play20Filled}" />
            </Button>
            <ToggleButton Width="34" Style="{StaticResource Toggle.Segment}" ToolTip="Loop range">
              <ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.RepeatAll20Regular}" />
            </ToggleButton>
            <Border Height="32" Margin="10,0,0,0" Padding="10,0" Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Primary}" Text="0003 : 02 : 144" />
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="120.00 BPM" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Margin="0,0,5,0" Content="Compile" />
            <Button Margin="0,0,5,0" Style="{StaticResource Button.Ghost}" Content="MIDI Export" />
            <Button Style="{StaticResource Button.Ghost}" Content="Render Audio" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Non-semantic preview notice -->
      <Border Grid.Row="3"
              Padding="12,0"
              Background="{StaticResource Brush.Red.Subtle}"
              BorderBrush="{StaticResource Brush.Red.Dark}"
              BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:FluentIcon Width="14" Height="14" Margin="0,0,7,0" Foreground="{StaticResource Brush.Red.Hover}" Data="{StaticResource Fluent.Info20Regular}" />
            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Text="Style preview" />
            <TextBlock Margin="7,0,0,0" Style="{StaticResource Text.Caption}" Text="All project content, diagnostics, and task states shown here are static visual samples." />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="24" Style="{StaticResource Button.Ghost}" Content="Review scope" />
        </Grid>
      </Border>

      <!-- Resizable main shell -->
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224" MinWidth="180" MaxWidth="340" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="560" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="276" MinWidth="232" MaxWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- Project panel -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="38" />
              <RowDefinition Height="52" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Panel.Header}">
              <Grid>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="PROJECT" />
              <Button Width="26" Height="26" HorizontalAlignment="Right" Style="{StaticResource Button.Icon}" ToolTip="Project panel options">
                <ui:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.MoreHorizontal20Regular}" />
              </Button>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="10,9">
              <TextBox Padding="28,3,8,3"
                       VerticalContentAlignment="Center"
                       Text="Search project"
                       Foreground="{StaticResource Brush.Text.Tertiary}" />
              <ui:FluentIcon Width="14"
                             Height="14"
                             Margin="9,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             UseLayoutRounding="True"
                             Foreground="{StaticResource Brush.Text.Tertiary}"
                             Data="{StaticResource Fluent.Search20Regular}" />
            </Grid>
            <ListBox Grid.Row="2" Margin="4,4,4,0" SelectedIndex="4">
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ui:FluentIcon Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Warning}" Data="{StaticResource Fluent.MusicNote220Regular}" />
                  <TextBlock Text="Conductor Track" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ui:FluentIcon Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Red.Hover}" Data="{StaticResource Fluent.Folder20Regular}" />
                  <TextBlock Text="Event Instrument Library" />
                  <Border Margin="8,0,0,0" Style="{StaticResource Badge.Count}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               LineHeight="12"
                               LineStackingStrategy="BlockLineHeight"
                               Style="{StaticResource Text.Caption}"
                               Text="4"
                               TextAlignment="Center" />
                  </Border>
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ui:FluentIcon Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Tertiary}" Data="{StaticResource Fluent.Document20Regular}" />
                  <TextBlock FontWeight="SemiBold" Text="Logical Tracks" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Padding="24,7,9,7">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Brush.Info}" />
                  <TextBlock Text="Lead Motif" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Padding="24,7,9,7">
                <ListBoxItem.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open in Arrangement" />
                    <MenuItem Header="Rename" />
                    <MenuItem Header="Duplicate" />
                    <Separator />
                    <MenuItem Header="Delete Track" Foreground="{StaticResource Brush.Red.Hover}" />
                  </ContextMenu>
                </ListBoxItem.ContextMenu>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Brush.Red}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Low Strings" />
                  <ui:FluentIcon Grid.Column="2" Width="14" Height="14" Foreground="{StaticResource Brush.Warning}" Data="{StaticResource Fluent.Warning20Regular}" ToolTip="One lane needs attention" />
                </Grid>
              </ListBoxItem>
              <ListBoxItem Padding="24,7,9,7">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{StaticResource Brush.Success}" />
                  <TextBlock Text="Percussive Glass" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ui:FluentIcon Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Tertiary}" Data="{StaticResource Fluent.Settings20Regular}" />
                  <TextBlock Text="Project Settings" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem>
                <StackPanel Orientation="Horizontal">
                  <ui:FluentIcon Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Red.Hover}" Data="{StaticResource Fluent.ErrorCircle20Regular}" />
                  <TextBlock Text="Diagnostics" />
                  <Border Margin="8,0,0,0" Style="{StaticResource Badge.Count.Error}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource Brush.Red.Hover}"
                               LineHeight="12"
                               LineStackingStrategy="BlockLineHeight"
                               Text="2"
                               TextAlignment="Center" />
                  </Border>
                </StackPanel>
              </ListBoxItem>
            </ListBox>
            <Border Grid.Row="3" Margin="10" Padding="10" Background="{StaticResource Brush.Surface.2}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource Text.Caption}" Text="PLAYBACK ENGINE" />
                  <Border HorizontalAlignment="Right" Style="{StaticResource Badge.Success}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Style="{StaticResource Status.Dot}" Fill="{StaticResource Brush.Success}" />
                      <TextBlock FontSize="10" Foreground="{StaticResource Brush.Success}" Text="STOPPED" />
                    </StackPanel>
                  </Border>
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Text="Default Audio Device · 48,000 Hz" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="Render-ahead 100 ms" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <!-- Workspace tabs and style gallery -->
        <TabControl Grid.Column="2" Background="{StaticResource Brush.Surface.0}" SelectedIndex="0">
          <TabItem Header="Style Gallery">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="18,16,18,28">
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="FOUNDATION / REVIEW 01" />
                    <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="Dark, restrained, signal-red." />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" Text="A compact component language for dense music editing without visual noise." />
                  </StackPanel>
                  <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Badge.Info}">
                    <TextBlock Foreground="{StaticResource Brush.Info}" Text="100% DPI baseline" />
                  </Border>
                </Grid>

                <!-- Palette -->
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Text.Section}" Text="Color roles" />
                      <TextBlock Margin="0,5,14,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="Near-black surfaces; red is reserved for active intent, play state, focus, and blocking severity." />
                    </StackPanel>
                    <UniformGrid Grid.Column="1" Rows="1" Columns="7">
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Black}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Black" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Surface" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Surface.3}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Raised" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Red}" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Signal" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Info}" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Info" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Warning}" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Warning" />
                      </StackPanel>
                      <StackPanel Margin="4">
                        <Border Height="36" Background="{StaticResource Brush.Success}" CornerRadius="3" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Ready" />
                      </StackPanel>
                    </UniformGrid>
                  </Grid>
                </Border>

                <!-- Arrangement component -->
                <Border Margin="0,0,0,12" Padding="0" Style="{StaticResource Card}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="44" />
                      <RowDefinition Height="22" />
                      <RowDefinition Height="54" />
                      <RowDefinition Height="54" />
                      <RowDefinition Height="54" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                      <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                          <TextBlock Style="{StaticResource Text.Section}" Text="Arrangement timeline" />
                          <Border Margin="10,0,0,0" Style="{StaticResource Badge}">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Canonical-aware shell" />
                          </Border>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                          <ToggleButton IsChecked="True" Style="{StaticResource Toggle.Segment}" Content="Bars" />
                          <ToggleButton Margin="4,0,0,0" Style="{StaticResource Toggle.Segment}" Content="Ticks" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Fit range">
                          <ui:FluentIcon Data="{StaticResource Fluent.ArrowFit20Regular}" />
                        </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource Brush.Surface.2}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="166" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="TRACK" />
                        <UniformGrid Grid.Column="1" Rows="1" Columns="8">
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="1.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="2.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="3.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="4.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="5.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="6.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="7.1" />
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="8.1" />
                        </UniformGrid>
                      </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="166" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource Timeline.TrackHeader}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Lead Motif" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="Glass Arc" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Toggle.TrackState}" Content="M" />
                            <ToggleButton Margin="3,0,0,0" Style="{StaticResource Toggle.TrackState}" Content="S" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border Grid.Column="1" Style="{StaticResource Timeline.Lane}">
                        <Grid ClipToBounds="True">
                          <UniformGrid Columns="8">
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" />
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" />
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" />
