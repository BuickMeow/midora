            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Save Project" Click="OnSaveProjectClick" IsEnabled="{Binding CanSaveProject}"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Save20Regular}"/></Button>
