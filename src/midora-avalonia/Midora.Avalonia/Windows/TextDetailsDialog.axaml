<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.TextDetailsDialog"
        x:CompileBindings="False"
        FontFamily="{DynamicResource Font.UI}"
        Width="720" Height="420" MinWidth="480" MinHeight="280"
        Background="{DynamicResource Brush.Surface.0}"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,58">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Background="Transparent" PointerPressed="OnTitlePointerPressed" />
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   IsHitTestVisible="False"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   TextTrimming="CharacterEllipsis" />
        <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCloseClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>
      <TextBox x:Name="MessageTextBox" Grid.Row="1" Margin="12" Padding="10"
               AcceptsReturn="True" FontFamily="{DynamicResource Font.Mono}" IsReadOnly="True"
               TextWrapping="NoWrap" VerticalContentAlignment="Top"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
      <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="CopyButton" Width="84" Margin="0,0,6,0" Content="Copy" Click="OnCopyClick" />
          <Button Classes="primary" Width="112" Content="Close" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
