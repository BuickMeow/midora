                        <Border Margin="0,5,5,0" Padding="12" Background="{StaticResource Brush.Damaged.Subtle}" BorderBrush="#694085" BorderThickness="1" CornerRadius="4">
                          <StackPanel>
                            <ui:FluentIcon Width="18" Height="18" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Damaged}" Data="{StaticResource Fluent.ErrorCircle20Regular}" />
                            <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="Damaged object" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="Name and object type remain readable; editing is blocked." />
                          </StackPanel>
                        </Border>
                        <Border Margin="5,5,0,0" Padding="12" Background="{StaticResource Brush.Warning.Subtle}" BorderBrush="#735820" BorderThickness="1" CornerRadius="4">
                          <StackPanel>
                            <ui:FluentIcon Width="18" Height="18" HorizontalAlignment="Left" Foreground="{StaticResource Brush.Warning}" Data="{StaticResource Fluent.Warning20Regular}" />
                            <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="No results" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="No diagnostics match the active filters." />
                          </StackPanel>
                        </Border>
                      </UniformGrid>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Arrangement">
            <Grid Background="{StaticResource Brush.Surface.0}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:FluentIcon Width="28" Height="28" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text.Tertiary}" Data="{StaticResource Fluent.Document20Regular}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Title}" Text="Arrangement workspace placeholder" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="The production workspace is intentionally not implemented in this sample." />
              </StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="Low Strings  ×">
            <Grid Background="{StaticResource Brush.Surface.0}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:FluentIcon Width="28" Height="28" HorizontalAlignment="Center" Foreground="{StaticResource Brush.Red.Hover}" Data="{StaticResource Fluent.MusicNote220Regular}" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Title}" Text="Track workspace placeholder" />
              </StackPanel>
            </Grid>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

        <!-- Inspector -->
        <Border Grid.Column="4" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="38" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Panel.Header}">
              <Grid>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="INSPECTOR" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Badge}">
                  <TextBlock Style="{StaticResource Text.Caption}" Text="1 selected" />
                </Border>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,14,14,22">
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Style="{StaticResource Text.Overline}" Text="LOGICAL TRACK" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Title}" Text="Low Strings" />
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Border Style="{StaticResource Badge.Success}">
                      <StackPanel Orientation="Horizontal">
                        <ui:FluentIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Success}" Data="{StaticResource Fluent.CheckmarkCircle20Regular}" />
                        <TextBlock Foreground="{StaticResource Brush.Success}" Text="VALID" />
                      </StackPanel>
                    </Border>
                    <Border Margin="5,0,0,0" Style="{StaticResource Badge.Warning}">
                      <TextBlock Foreground="{StaticResource Brush.Warning}" Text="1 NOTICE" />
                    </Border>
                  </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource Field.Label}" Text="DISPLAY NAME" />
                <TextBox Margin="0,0,0,12" Text="Low Strings" />

                <TextBlock Style="{StaticResource Field.Label}" Text="EVENT INSTRUMENT" />
                <ComboBox Margin="0,0,0,12" SelectedIndex="1">
                  <ComboBoxItem Content="Glass Arc" />
                  <ComboBoxItem Content="Dark Ensemble" />
                  <ComboBoxItem Content="Felt Pulse" />
                  <ComboBoxItem Content="Unassigned" />
                </ComboBox>

                <Border Margin="0,0,0,12" Padding="10" Background="{StaticResource Brush.Warning.Subtle}" BorderBrush="#735820" BorderThickness="1" CornerRadius="4">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ui:FluentIcon Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.Warning}" Data="{StaticResource Fluent.Warning20Regular}" />
                      <TextBlock FontWeight="SemiBold" Text="Binding impact" />
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="Replacing this binding may make one logical parameter lane inapplicable." />
                    <Button Margin="0,9,0,0" HorizontalAlignment="Left" Height="26" Style="{StaticResource Button.Ghost}" Content="View affected lane" />
                  </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Field.Label}" Text="VALUE SOURCE" />
                    <TextBlock Foreground="{StaticResource Brush.Text.Primary}" Text="Explicit Override" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Style="{StaticResource Toggle.Switch}" />
                </Grid>

                <TextBlock Style="{StaticResource Field.Label}" Text="PLAYBACK MASTER VOLUME" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                  </Grid.ColumnDefinitions>
                  <Slider Minimum="-60" Maximum="6" Value="-0.1" />
                  <Border Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               Style="{StaticResource Text.Mono}"
                               Text="-0.1" />
                  </Border>
                </Grid>

                <TextBlock Style="{StaticResource Field.Label}" Text="TRACK ORDER" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="2" />
                  <Button Grid.Column="1" Margin="4,0,0,0" Padding="0">
                    <ui:FluentIcon Style="{StaticResource Icon.Stepper}" Data="{StaticResource Fluent.Subtract20Regular}" />
                  </Button>
                  <Button Grid.Column="2" Margin="4,0,0,0" Padding="0">
                    <ui:FluentIcon Style="{StaticResource Icon.Stepper}" Data="{StaticResource Fluent.Add20Regular}" />
                  </Button>
                </Grid>

                <TextBlock Style="{StaticResource Field.Label}" Text="OBJECT TYPE" />
                <TextBox Margin="0,0,0,12" IsReadOnly="True" Text="Logical Track" />

                <Expander Header="Advanced" IsExpanded="False">
                  <StackPanel>
                    <CheckBox IsChecked="True" Content="Include in default export selection" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="This control is shown for visual review only; no Project setting is written." />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="5" Padding="10,0" Background="{StaticResource Brush.Black}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Ellipse Style="{StaticResource Status.Dot}" Fill="{StaticResource Brush.Success}" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Secondary}" Text="Stopped" />
            <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="Compile state: Needs compile" />
            <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="3 diagnostics" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Caption}" Text="TPQ 192" />
            <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="Zoom 100%" />
            <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="win-x64 · .NET 10" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
