<Window x:Class="Midora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Midora.Desktop"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Brush.Surface.0}"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Closing="OnWindowClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <ContextMenu x:Key="TimelineContextMenu" x:Shared="False" Opened="OnTimelineContextMenuOpened">
      <MenuItem Header="Open" Click="OnOpenWorkspaceSelectionClick"/>
      <Separator/>
      <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnCutClick"/>
      <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="OnCopyClick"/>
      <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnPasteClick"/>
      <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnDuplicateClick"/>
      <Separator/>
      <MenuItem Header="Delete" InputGestureText="Delete" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnDeleteWorkspaceSelectionClick"/>
      <Separator/>
      <MenuItem Header="Set Time Range from Object Selection" Click="OnSetTimeRangeFromObjectsClick"/>
      <MenuItem Header="Select Objects in Time Range" Click="OnSelectObjectsInTimeRangeClick"/>
      <MenuItem Header="Clear Time Range" Click="OnClearTimeRangeClick"/>
    </ContextMenu>
    <ContextMenu x:Key="DiagnosticContextMenu" x:Shared="False">
      <MenuItem Header="Go to Source" Click="OnNavigateDiagnosticClick"/>
      <Separator/>
      <MenuItem Header="Copy Message" Click="OnCopyDiagnosticMessageClick"/>
      <MenuItem Header="Copy Code" Click="OnCopyDiagnosticCodeClick"/>
    </ContextMenu>
    <Style x:Key="PanelHeader" TargetType="Border">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="PropertyLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SingleLineWorkspaceTabs" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Background="{StaticResource Brush.Surface.1}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                  <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                </ScrollViewer>
                <Button Grid.Column="1" Width="28" Height="28" Margin="2" Padding="0" Style="{StaticResource Button.Icon}"
                        ToolTip="Workspace list" Click="OnWorkspaceTabListClick">
                  <TextBlock FontSize="14" Text="▾"/>
                </Button>
              </Grid>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                Content="{TemplateBinding SelectedItem}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ProjectSettingFieldTemplate">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Style="{StaticResource PropertyLabel}" Text="{Binding Label}"/>
        <Grid>
          <TextBox Tag="{Binding}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                   LostKeyboardFocus="OnProjectSettingLostKeyboardFocus"
                   KeyDown="OnProjectSettingKeyDown">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsReadOnly" Value="False"/></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <ComboBox Tag="{Binding}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="OnProjectSettingChoiceDropDownClosed">
            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsChoice}" Value="True"/><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></ComboBox.Style>
          </ComboBox>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
    </Style>
    <Style x:Key="RenderedSurfaceHost" TargetType="GroupBox">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type local:ProjectTreeNode}" ItemsSource="{Binding Children}">
      <Border x:Name="TreeChrome" Padding="4,3" Background="Transparent" CornerRadius="3">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="TreeTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="TreeRename" Margin="-3,-2" Padding="3,1" Visibility="Collapsed"
                   Grid.ColumnSpan="2"
                   Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Loaded="OnTreeRenameLoaded" LostKeyboardFocus="OnTreeRenameLostKeyboardFocus"
                   KeyDown="OnTreeRenameKeyDown"/>
        </Grid>
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True">
          <Setter TargetName="TreeChrome" Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="TreeTitle" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="TreeRename" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDamaged}" Value="True">
          <Setter TargetName="TreeTitle" Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/>
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type local:TimelineWorkspaceViewModel}">
      <Grid Background="{StaticResource Brush.Surface.0}">
        <Grid.RowDefinitions>
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="{Binding BottomEditorRowHeight, Mode=TwoWay}" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PanelHeader}">
          <Grid>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Header}" />
              <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Context}" />
              <ToggleButton Margin="9,0,0,0" Padding="7,0" Content="Lanes" IsChecked="{Binding IsLowerEditorVisible, Mode=TwoWay}">
                <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ToggleButton.Style>
              </ToggleButton>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <ToggleButton Width="44" Margin="0,0,4,0" Padding="0" Content="Grid" IsChecked="{Binding EditorSettings.GridVisible, Mode=TwoWay}" ToolTip="Show subdivision grid"/>
              <ComboBox Width="92" Height="24" Margin="0,0,4,0" IsEditable="True"
                        ItemsSource="{Binding EditorSettings.SubdivisionPresets}"
                        Text="{Binding EditorSettings.DisplaySubdivisionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Tag="Display" LostKeyboardFocus="OnSubdivisionComboBoxLostKeyboardFocus"
                        ToolTip="Display subdivision; enter Bar or any positive n in 1/n"/>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <ToggleButton Margin="0,0,4,0" Content="Snap" IsChecked="{Binding EditorSettings.SnapEnabled, Mode=TwoWay}"/>
              <ComboBox Width="92" Height="24" Margin="0,0,4,0" IsEditable="True"
                        ItemsSource="{Binding EditorSettings.SubdivisionPresets}"
                        Text="{Binding EditorSettings.OperationSubdivisionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Tag="Operation" LostKeyboardFocus="OnSubdivisionComboBoxLostKeyboardFocus"
                        ToolTip="Operation subdivision; enter any positive n in 1/n"/>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <TextBlock Margin="3,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Length"/>
              <TextBox Width="58" Height="24" Margin="0,0,4,0" Padding="5,0" Text="{Binding EditorSettings.DefaultLengthTicks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Default creation length in ticks"/>
              <StackPanel Margin="0,0,4,0" Orientation="Horizontal">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Margin="3,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Vel"/>
                <TextBox Width="42" Height="24" Padding="5,0" Text="{Binding EditorSettings.DefaultVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Default note velocity (1–127)"/>
              </StackPanel>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <Button Width="26" Height="24" Margin="0,0,2,0" Padding="0" Content="−" ToolTip="Zoom out" Tag="Out" Click="OnTimelineZoomClick"/>
              <Button Width="26" Height="24" Margin="0,0,6,0" Padding="0" Content="+" ToolTip="Zoom in" Tag="In" Click="OnTimelineZoomClick"/>
              <Border Width="1" Height="18" Margin="0,0,7,0" Background="{StaticResource Brush.Border}"/>
              <ToggleButton Margin="0,0,4,0" Content="Draw" Tag="Draw" IsChecked="{Binding IsDrawTool, Mode=OneWay}" Click="OnTimelineToolClick" />
              <ToggleButton Margin="0,0,4,0" Content="Select" Tag="Select" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Click="OnTimelineToolClick" />
              <ToggleButton Margin="0,0,4,0" Content="Split" Tag="Split" IsChecked="{Binding IsSplitTool, Mode=OneWay}" Click="OnTimelineToolClick"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsArrangement}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton>
              <ToggleButton Content="Erase" Tag="Erase" IsChecked="{Binding IsEraseTool, Mode=OneWay}" Click="OnTimelineToolClick" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
          </Grid.RowDefinitions>
        <GroupBox Style="{StaticResource RenderedSurfaceHost}" AutomationProperties.Name="{Binding Header}" AutomationProperties.AutomationId="PrimaryTimelineSurface">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ui:TimelineSurface x:Name="Timeline"
                            Focusable="True"
                            Snapshot="{Binding Snapshot}"
                            RulerSnapshot="{Binding RulerSnapshot}"
                            CanEdit="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            StartTick="{Binding StartTick, Mode=TwoWay}"
                            TickSpan="{Binding TickSpan, Mode=TwoWay}"
                            FirstLane="{Binding FirstLane, Mode=TwoWay}"
                            LaneHeight="{Binding LaneHeight, Mode=TwoWay}"
                            GridStepTicks="{Binding GridStepTicks}"
                            OperationStepTicks="{Binding OperationStepTicks}"
                            DisplayGridUsesBars="{Binding EditorSettings.DisplayGridUsesBars}"
                            OperationUsesBars="{Binding EditorSettings.EffectiveOperationUsesBars}"
                            TimeSignatureMap="{Binding EditorSettings.TimeSignatureMap}"
                            DefaultCreationLengthTicks="{Binding EditorSettings.DefaultLengthTicks}"
                            DefaultVelocity="{Binding EditorSettings.DefaultVelocity}"
                            SurfaceMode="{Binding SurfaceMode}"
                            ToolMode="{Binding ToolMode}"
                            GridVisible="{Binding GridVisible}"
                            ContextMenu="{StaticResource TimelineContextMenu}"
                             EditCursorTick="{Binding EditCursorTick}"
                             PlaybackCursorTick="{Binding PlaybackCursorTick}"
                            RangeStartTick="{Binding RangeStartTick}"
                            RangeEndTick="{Binding RangeEndTick}"
                            TimeRangeStartTick="{Binding TimeRangeStartTick}"
                            TimeRangeEndTick="{Binding TimeRangeEndTick}"
                            ItemInvoked="OnTimelineItemInvoked"
                            ItemEditCompleted="OnTimelineItemEditCompleted"
                            BackgroundInvoked="OnTimelineBackgroundInvoked"
                            LanePreviewPressed="OnTimelineLanePreviewPressed"
                            LanePreviewReleased="OnTimelineLanePreviewReleased"
                            NotePlacementStarted="OnTimelineNotePlacementStarted"
                            NotePlacementCompleted="OnTimelineNotePlacementCompleted"
                            NotePlacementCancelled="OnTimelineNotePlacementCancelled"
                             LaneHeaderCommandInvoked="OnTimelineLaneHeaderCommandInvoked"
                             LaneHeaderInvoked="OnTimelineLaneHeaderInvoked"
                             RulerClicked="OnTimelineRulerClicked"
                             TimeRangeSelected="OnTimelineTimeRangeSelected"
                             SegmentSplitRequested="OnTimelineSegmentSplitRequested"
                              MarqueeCompleted="OnTimelineMarqueeCompleted" />
          <ScrollBar Grid.Column="1" Width="12" Orientation="Vertical" Maximum="{Binding MaximumFirstLane, ElementName=Timeline}" Value="{Binding FirstLane, ElementName=Timeline, Mode=TwoWay}" SmallChange="1" LargeChange="{Binding VisibleLaneCount, ElementName=Timeline}" ViewportSize="{Binding VisibleLaneCount, ElementName=Timeline}">
            <ScrollBar.Style><Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ScrollBar.Style>
          </ScrollBar>
        </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Style="{StaticResource RenderedSurfaceHost}" AutomationProperties.Name="Timeline overview and horizontal scroll" AutomationProperties.AutomationId="PrimaryTimelineOverview">
        <ui:TimelineOverviewSurface
                                    Snapshot="{Binding Snapshot}"
                                    StartTick="{Binding StartTick, Mode=TwoWay}"
                                    TickSpan="{Binding TickSpan}"
                                    ExtentEndTick="{Binding TimelineExtentEndTick}"/>
        </GroupBox>
        </Grid>
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext">
          <GridSplitter.Style><Style TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSegment}" Value="True"/><Condition Binding="{Binding IsLowerEditorVisible}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></GridSplitter.Style>
        </GridSplitter>
        <TabControl Grid.Row="3">
          <TabControl.Style><Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
          <TabItem Header="Velocity">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:TimelineSurface x:Name="SegmentVelocityTimeline" Tag="Velocity" Snapshot="{Binding VelocitySnapshot}" SurfaceMode="Velocity"
                                CanEdit="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                StartTick="{Binding StartTick, Mode=TwoWay}" TickSpan="{Binding TickSpan, Mode=TwoWay}"
                                FirstLane="0" LaneHeight="160" GridStepTicks="{Binding GridStepTicks}" GridVisible="{Binding GridVisible}"
                                DisplayGridUsesBars="{Binding EditorSettings.DisplayGridUsesBars}" TimeSignatureMap="{Binding EditorSettings.TimeSignatureMap}"
                                EditCursorTick="{Binding EditCursorTick}" PlaybackCursorTick="{Binding PlaybackCursorTick}"
                                VelocityEditCompleted="OnTimelineVelocityEditCompleted"/>
            <ScrollBar Grid.Column="1" Width="12" Orientation="Vertical" Maximum="{Binding ValueScrollMaximum, ElementName=SegmentVelocityTimeline}" Value="{Binding ValueScrollOffset, ElementName=SegmentVelocityTimeline, Mode=TwoWay}" ViewportSize="{Binding ValueScrollViewportSize, ElementName=SegmentVelocityTimeline}"/>
            </Grid>
          </TabItem>
          <TabItem Header="Parameter Lane">
            <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Padding="8,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"><Grid><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="LANE"/><ComboBox Width="210" Height="24" ItemsSource="{Binding ParameterLaneLabels}" SelectedIndex="{Binding ActiveParameterLaneIndex, Mode=TwoWay}" DropDownClosed="OnActiveEditorLaneDropDownClosed"/></StackPanel><Button HorizontalAlignment="Right" Height="22" Padding="7,0" Content="Add Lane" Click="OnAddParameterLaneClick"/></Grid></Border>
              <GroupBox Grid.Row="1" Style="{StaticResource RenderedSurfaceHost}" AutomationProperties.Name="Logical Parameter lane" AutomationProperties.AutomationId="LogicalParameterTimelineSurface">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ui:TimelineSurface x:Name="SegmentParameterTimeline" Tag="ParameterLanes" Snapshot="{Binding ParameterSnapshot}" ContextMenu="{StaticResource TimelineContextMenu}"
                                    CanEdit="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    StartTick="{Binding StartTick, Mode=TwoWay}" TickSpan="{Binding TickSpan, Mode=TwoWay}"
                                    FirstLane="0" LaneHeight="160" GridStepTicks="{Binding GridStepTicks}" OperationStepTicks="{Binding OperationStepTicks}"
                                    DisplayGridUsesBars="{Binding EditorSettings.DisplayGridUsesBars}" OperationUsesBars="{Binding EditorSettings.EffectiveOperationUsesBars}" TimeSignatureMap="{Binding EditorSettings.TimeSignatureMap}"
                                    ValueAxisMinimum="{Binding ActiveValueMinimum}" ValueAxisMaximum="{Binding ActiveValueMaximum}" ValueAxisIntegral="{Binding ActiveValueIntegral}"
                                    SurfaceMode="EventLanes" EditCursorTick="{Binding EditCursorTick}" GridVisible="{Binding GridVisible}"
                                    PlaybackCursorTick="{Binding PlaybackCursorTick}" RangeStartTick="{Binding RangeStartTick}" RangeEndTick="{Binding RangeEndTick}"
                                    TimeRangeStartTick="{Binding TimeRangeStartTick}" TimeRangeEndTick="{Binding TimeRangeEndTick}"
                                    ItemInvoked="OnTimelineItemInvoked" ItemEditCompleted="OnTimelineItemEditCompleted" BackgroundInvoked="OnTimelineBackgroundInvoked"
                                    LaneHeaderInvoked="OnTimelineLaneHeaderInvoked" RulerClicked="OnTimelineRulerClicked" TimeRangeSelected="OnTimelineTimeRangeSelected" MarqueeCompleted="OnTimelineMarqueeCompleted"/>
                <ScrollBar Grid.Column="1" Width="12" Orientation="Vertical" Maximum="{Binding ValueScrollMaximum, ElementName=SegmentParameterTimeline}" Value="{Binding ValueScrollOffset, ElementName=SegmentParameterTimeline, Mode=TwoWay}" ViewportSize="{Binding ValueScrollViewportSize, ElementName=SegmentParameterTimeline}"/>
                </Grid>
              </GroupBox>
            </Grid>
          </TabItem>
        </TabControl>
        <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsConductor}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="8,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"><Grid><TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="CONDUCTOR EVENT LIST"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Select to locate · Inspector edits the formal event"/></Grid></Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding ConductorEvents}" SelectionChanged="OnConductorEventSelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Tick, StringFormat={}Tick {0}}"/><TextBlock Grid.Column="1" Text="{Binding Type}"/><TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:LibraryWorkspaceViewModel}">
      <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Text.Title}" Text="Event Instrument Library" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,5,0" Content="New Folder" Click="OnNewInstrumentFolderClick" />
            <Button Style="{StaticResource Button.Primary}" Content="New Instrument" Click="OnNewInstrumentClick" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Margin="0,0,6,0" ToolTip="Filter by instrument name, folder, or status" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
          <ComboBox Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Margin="0,0,5,0" Content="Duplicate" IsEnabled="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Click="OnDuplicateLibraryInstrumentClick"/><Button Content="Move…" IsEnabled="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Click="OnMoveLibraryInstrumentClick"/></StackPanel>
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Instruments}" SelectedItem="{Binding SelectedInstrument, Mode=TwoWay}" MouseDoubleClick="OnInstrumentListDoubleClick" PreviewMouseRightButtonDown="OnListBoxRightButtonDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
          <ListBox.ContextMenu><ContextMenu><MenuItem Header="Open" Click="OnOpenLibraryInstrumentClick"/><Separator/><MenuItem Header="Duplicate" Click="OnDuplicateLibraryInstrumentClick"/><MenuItem Header="Move to Folder…" Click="OnMoveLibraryInstrumentClick"/><Separator/><MenuItem Header="Delete Event Instrument…" Click="OnDeleteLibraryInstrumentClick"/></ContextMenu></ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" Text="{Binding Folder}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}" Text="{Binding UsageCount, StringFormat={}Used {0}}" />
                <TextBlock Grid.Column="3" Foreground="{StaticResource Brush.Success}" Text="{Binding Status}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
