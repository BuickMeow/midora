{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora settings/soundfont-settings.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode"],
  "properties": {
    "schemaVersion": {
      "$ref": "common-v1.schema.json#/$defs/schemaVersion"
    },
    "mode": {
      "enum": ["none", "external", "embedded"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f-\\u009f]+|[sS][oO][uU][nN][dD][fF][oO][nN][tT][sS]/[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f-\\u009f]+)\\.[sS][fF]2$"
    },
    "resourceId": {
      "$ref": "common-v1.schema.json#/$defs/stableId"
    },
    "originalFileName": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f-\\u009f]+\\.[sS][fF]2$"
    },
    "sha256": {
      "$ref": "common-v1.schema.json#/$defs/sha256"
    },
    "fileSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": { "const": "none" }
      },
      "not": {
        "anyOf": [
          { "required": ["relativePath"] },
          { "required": ["resourceId"] },
          { "required": ["originalFileName"] },
          { "required": ["sha256"] },
          { "required": ["fileSizeBytes"] }
        ]
      }
    },
    {
      "properties": {
        "mode": { "const": "external" }
      },
      "required": ["relativePath", "originalFileName", "sha256", "fileSizeBytes"],
      "not": {
        "required": ["resourceId"]
      }
    },
    {
      "properties": {
        "mode": { "const": "embedded" }
      },
      "required": ["resourceId", "originalFileName", "sha256", "fileSizeBytes"],
      "not": {
        "required": ["relativePath"]
      }
    }
  ]
}
