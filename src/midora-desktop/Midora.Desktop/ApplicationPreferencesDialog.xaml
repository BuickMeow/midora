<Window x:Class="Midora.Desktop.ApplicationPreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Application Preferences" Width="720" Height="720" MinWidth="620" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface.0}" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
        <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Application Preferences"/>
        <Button Width="46" Height="38" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" ToolTip="Close" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="Realtime Audio"/>
          <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Changes are accepted only while playback is stopped and no foreground task is running." TextWrapping="Wrap"/>

          <TextBlock Style="{StaticResource Text.Overline}" Text="PLAYBACK OUTPUT DEVICE"/>
          <ComboBox x:Name="DeviceBox" Margin="0,5,0,0" DisplayMemberPath="DisplayName"/>
          <TextBlock x:Name="DeviceStatusText" Margin="0,5,0,14" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="RENDER-AHEAD (ms)"/><TextBox x:Name="RenderAheadBox" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="DEVICE REQUEST (ms)"/><TextBox x:Name="DeviceRequestBox" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Text.Overline}" Text="MAX VOICES / UNIT"/><TextBox x:Name="VoicesBox" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}" Text="20–2,000"/><TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="5–200"/><TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" Text="1–16,777,216"/>
          </Grid>

          <Border Height="1" Margin="0,18" Background="{StaticResource Brush.Border}"/>
          <TextBlock Style="{StaticResource Text.Section}" Text="Audio Cache"/>
          <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Only the local absolute root and reusable quota are persisted. Session and transient recovery data remain runtime state." TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource Text.Overline}" Text="LOCAL CACHE ROOT"/>
          <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CacheRootBox" IsReadOnly="True"/><Button Grid.Column="1" Width="82" Margin="7,0,0,0" Content="Browse…" Click="OnBrowseCacheClick"/></Grid>
          <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Overline}" Text="MAXIMUM REUSABLE CACHE (GiB)"/>
          <TextBox x:Name="CacheQuotaBox" Width="190" Margin="0,5,0,0" HorizontalAlignment="Left"/>
          <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="0 disables reusable audio-cache retention. Transient recovery storage is separate." TextWrapping="Wrap"/>

          <Border Height="1" Margin="0,18" Background="{StaticResource Brush.Border}"/>
          <TextBlock Style="{StaticResource Text.Section}" Text="New Project SoundFont"/>
          <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Optionally embed this local SF2 automatically when creating a Project or opening MIDI as a new Project. Clear the path to leave new Projects without a SoundFont." TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource Text.Overline}" Text="DEFAULT EMBEDDED SF2"/>
          <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DefaultSoundFontBox" IsReadOnly="True"/><Button Grid.Column="1" Width="82" Margin="7,0,0,0" Content="Browse…" Click="OnBrowseDefaultSoundFontClick"/><Button Grid.Column="2" Width="72" Margin="7,0,0,0" Content="Clear" Click="OnClearDefaultSoundFontClick"/></Grid>

          <Border x:Name="ValidationBorder" Margin="0,18,0,0" Padding="9" Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid><Button Width="132" HorizontalAlignment="Left" Content="Restore Defaults" Click="OnRestoreDefaultsClick"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,7,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/><Button Style="{StaticResource Button.Dialog.Confirm}" Content="Apply" Click="OnApplyClick"/></StackPanel></Grid>
      </Border>
    </Grid>
  </Border>
</Window>
