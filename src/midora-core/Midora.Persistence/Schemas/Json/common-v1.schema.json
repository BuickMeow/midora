{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora Persistence Common Types v1",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "stableId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shortText": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "requiredShortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "metadataText": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 65536,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
    },
    "mappingBody": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^[^\\r\\n]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "editingDurationMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\/$)[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "rgbColor": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "midiState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controllers", "registeredParameters", "nonRegisteredParameters"],
      "properties": {
        "bankMsb": { "type": "integer", "minimum": 0, "maximum": 127 },
        "bankLsb": { "type": "integer", "minimum": 0, "maximum": 127 },
        "program": { "type": "integer", "minimum": 0, "maximum": 127 },
        "pitchBend": { "type": "integer", "minimum": -8192, "maximum": 8191 },
        "pitchBendRangeSemitones": { "type": "integer", "minimum": 0, "maximum": 127 },
        "pitchBendRangeCents": { "type": "integer", "minimum": 0, "maximum": 99 },
        "controllers": {
          "type": "array",
          "items": { "$ref": "#/$defs/controllerStateEntry" }
        },
        "registeredParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterStateEntry" }
        },
        "nonRegisteredParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterStateEntry" }
        }
      }
    },
    "controllerStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "value"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 119,
          "not": { "enum": [91, 93] }
        },
        "value": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    },
    "parameterStateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "value"],
      "properties": {
        "number": { "type": "integer", "minimum": 0, "maximum": 16383 },
        "value": { "type": "integer", "minimum": 0, "maximum": 16383 }
      }
    }
  }
}
