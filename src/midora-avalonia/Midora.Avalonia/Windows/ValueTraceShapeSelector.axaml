<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Midora.Avalonia.Controls"
             x:Class="Midora.Avalonia.Windows.ValueTraceShapeSelector"
             x:CompileBindings="False"
             Focusable="False">
  <UserControl.Styles>
    <Style Selector="ToggleButton">
      <Setter Property="Width" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
    <ToggleButton x:Name="Free" Tag="Free" Click="OnShapeClick"
                  ToolTip.Tip="Free draw (Alt+drag forces the selected shape)">
      <controls:FluentIcon Width="16" Height="16" Data="{DynamicResource Fluent.Pen20Regular}" />
    </ToggleButton>
    <ToggleButton x:Name="Line" Tag="Line" Click="OnShapeClick" ToolTip.Tip="Draw a straight line">
      <controls:FluentIcon Width="16" Height="16" Data="{DynamicResource Fluent.Line20Filled}" />
    </ToggleButton>
    <ToggleButton x:Name="Horizontal" Tag="Horizontal" Click="OnShapeClick"
                  ToolTip.Tip="Draw a horizontal line at the starting value">
      <controls:FluentIcon Width="16" Height="16" Data="{DynamicResource Fluent.Subtract20Filled}" />
    </ToggleButton>
  </StackPanel>
</UserControl>
