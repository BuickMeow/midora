{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora project.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nextStableId",
    "metadataPath",
    "conductorTrackPath",
    "settings",
    "eventInstrumentFolders",
    "eventInstruments",
    "logicalTracks"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "nextStableId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
    "metadataPath": { "const": "metadata.json" },
    "conductorTrackPath": { "const": "conductor-track.json" },
    "settings": { "$ref": "#/$defs/settingsPaths" },
    "eventInstrumentFolders": {
      "type": "array",
      "items": { "$ref": "#/$defs/folderIndex" }
    },
    "eventInstruments": {
      "type": "array",
      "items": { "$ref": "#/$defs/eventInstrumentIndex" }
    },
    "logicalTracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/logicalTrackIndex" }
    }
  },
  "$defs": {
    "settingsPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "export",
        "playback",
        "audioRender",
        "soundFont",
        "globalResetDefaults",
        "globalEventScopeDefaults"
      ],
      "properties": {
        "project": { "const": "settings/project-settings.json" },
        "export": { "const": "settings/export-settings.json" },
        "playback": { "const": "settings/playback-settings.json" },
        "audioRender": { "const": "settings/audio-render-settings.json" },
        "soundFont": { "const": "settings/soundfont-settings.json" },
        "globalResetDefaults": { "const": "settings/global-reset-defaults.json" },
        "globalEventScopeDefaults": { "const": "settings/global-event-scope-defaults.json" }
      }
    },
    "folderIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "name": { "$ref": "common-v1.schema.json#/$defs/requiredShortText" }
      }
    },
    "eventInstrumentIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "nameSnapshot"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^event-instruments/ei_[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/shortText" },
        "folderId": { "$ref": "common-v1.schema.json#/$defs/stableId" }
      }
    },
    "logicalTrackIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "nameSnapshot"],
      "properties": {
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^logical-tracks/lt_[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/shortText" }
      }
    }
  }
}
