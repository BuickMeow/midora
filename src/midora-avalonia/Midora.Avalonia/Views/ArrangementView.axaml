<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Midora.Avalonia.Controls"
             xmlns:presentation="using:Midora.Avalonia.Presentation.Controls"
             xmlns:views="using:Midora.Avalonia.Views"
             x:Class="Midora.Avalonia.Views.ArrangementView"
             x:CompileBindings="False">
  <Grid RowDefinitions="34,*" Background="{DynamicResource Brush.Surface.0}">
    <!-- Workspace header (WPF arrangement PanelHeader: context text + timeline toolbar). -->
    <Border Background="{DynamicResource Brush.Surface.1}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="10,0">
        <TextBlock x:Name="ContextText" Classes="caption" VerticalAlignment="Center"
                   Text="0 tracks · 0 segments" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PointerText" Classes="mono" MinWidth="82" Margin="0,0,7,0"
                     VerticalAlignment="Center" TextAlignment="Right"
                     Foreground="{DynamicResource Brush.Text.Primary}" IsVisible="False" />
          <Border x:Name="PointerSeparator" Width="1" Height="18" Margin="0,0,7,0"
                  Background="{DynamicResource Brush.Border}" IsVisible="False" />
          <ToggleButton x:Name="GridToggle" Width="44" Height="24" Margin="0,0,4,0" Padding="0"
                        Content="Grid" ToolTip.Tip="Show subdivision grid"
                        IsChecked="{Binding #Timeline.GridVisible, Mode=TwoWay}" />
          <Border Width="1" Height="18" Margin="3,0,7,0" Background="{DynamicResource Brush.Border}" />
          <ToggleButton x:Name="SnapToggle" Height="24" Margin="0,0,4,0" Padding="9,0" Content="Snap"
                        ToolTip.Tip="Enable/Disable Snap (A)"
                        IsChecked="{Binding IsSnapEnabled, Mode=TwoWay}" />
          <ComboBox x:Name="SubdivisionBox" Width="92" Height="24" Margin="0,0,4,0" IsEditable="True"
                    ToolTip.Tip="Operation subdivision; enter any positive n in 1/n" />
          <Border Width="1" Height="18" Margin="3,0,7,0" Background="{DynamicResource Brush.Border}" />
          <TextBlock Margin="3,0" VerticalAlignment="Center" Classes="caption" Text="Length" />
          <TextBox x:Name="LengthBox" Width="58" Height="24" Margin="0,0,4,0" Padding="5,0" Text="1920"
                   ToolTip.Tip="Default creation length in ticks" />
          <Border Width="1" Height="18" Margin="3,0,7,0" Background="{DynamicResource Brush.Border}" />
          <Button Classes="icon ghost" Width="26" Height="24" Margin="0,0,2,0" Padding="0"
                  ToolTip.Tip="Zoom out" Click="OnZoomOutClick">
            <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomOut20Regular}" />
          </Button>
          <Button Classes="icon ghost" Width="26" Height="24" Margin="0,0,6,0" Padding="0"
                  ToolTip.Tip="Zoom in" Click="OnZoomInClick">
            <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomIn20Regular}" />
          </Button>
          <Button Classes="icon ghost" Width="26" Height="24" Margin="0,0,6,0" Padding="0"
                  ToolTip.Tip="All Tracks" Click="OnAllTracksClick">
            <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.LayerDiagonal20Regular}" />
          </Button>
          <Border Width="1" Height="18" Margin="0,0,7,0" Background="{DynamicResource Brush.Border}" />
          <ToggleButton x:Name="DrawToggle" Width="30" Height="24" Margin="0,0,4,0" Padding="0"
                        ToolTip.Tip="Draw (D)" Tag="Draw" Click="OnToolClick">
            <controls:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.Pen20Regular}" />
          </ToggleButton>
          <ToggleButton x:Name="SelectToggle" Width="30" Height="24" Margin="0,0,4,0" Padding="0"
                        IsChecked="True" ToolTip.Tip="Select (S)" Tag="Select" Click="OnToolClick">
            <controls:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.SelectObject20Regular}" />
          </ToggleButton>
          <ToggleButton x:Name="SplitToggle" Width="30" Height="24" Margin="0,0,4,0" Padding="0"
                        ToolTip.Tip="Split" Tag="Split" Click="OnToolClick">
            <controls:FluentIcon Width="16" Height="16" Data="{StaticResource Fluent.SplitVertical20Regular}" />
          </ToggleButton>
          <ToggleButton x:Name="EraseToggle" Width="30" Height="24" Padding="0"
                        ToolTip.Tip="Erase (E)" Tag="Erase" Click="OnToolClick">
            <controls:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.Eraser20Regular}" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="*,10" ColumnDefinitions="232,*,10">
      <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="32,*">
        <!-- WPF arrangement lane-header corner: Event Instruments, Add Track, vertical zoom, reset monitoring. -->
        <Border Background="{DynamicResource Brush.Surface.1}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
          <Grid Margin="5,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <ToggleButton Width="24" Height="22" Margin="0,0,4,0" Padding="0"
                          ToolTip.Tip="Show or hide Event Instruments">
              <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.Guitar20Regular}" />
            </ToggleButton>
            <Button Grid.Column="1" Width="24" Height="22" Padding="0" ToolTip.Tip="Add Track">
              <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.Add20Regular}" />
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="New Logical Track" Tag="Logical" Click="OnAddTrackMenuClick" />
                  <MenuItem Header="New Logical Track with Instrument…" Tag="Instrument" Click="OnAddTrackMenuClick" />
                  <Separator />
                  <MenuItem Header="New MIDI Track…" Tag="Midi" Click="OnAddTrackMenuClick" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <Button Width="24" Height="22" Margin="0,0,2,0" Padding="0"
                      ToolTip.Tip="Vertical zoom out" Click="OnLaneZoomOutClick">
                <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomOut20Regular}" />
              </Button>
              <Button Width="24" Height="22" Margin="0,0,4,0" Padding="0"
                      ToolTip.Tip="Vertical zoom in" Click="OnLaneZoomInClick">
                <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomIn20Regular}" />
              </Button>
              <Button Width="24" Height="22" Padding="0"
                      ToolTip.Tip="Reset all Track mute and solo states" Click="OnResetMonitoringClick">
                <controls:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.Speaker220Regular}" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <views:LaneHeaderStrip x:Name="LaneHeaders" Grid.Row="1" RulerHeight="0" />
      </Grid>
      <presentation:TimelineSurface x:Name="Timeline"
                                    Grid.Row="0" Grid.Column="1"
                                    LaneHeight="56"
                                    TicksPerQuarterNote="480"
                                    GridVisible="True"
                                    ShowTrackNames="False" />
      <ScrollBar Grid.Row="0" Grid.Column="2" Orientation="Vertical" AllowAutoHide="False"
                 Maximum="{Binding #Timeline.MaximumFirstLane}"
                 Value="{Binding #Timeline.FirstLane, Mode=TwoWay}"
                 ViewportSize="{Binding #Timeline.VisibleLaneCount}"
                 SmallChange="1"
                 LargeChange="{Binding #Timeline.VisibleLaneCount}" />
      <ScrollBar Grid.Row="1" Grid.Column="1" Orientation="Horizontal" AllowAutoHide="False"
                 Maximum="{Binding #Timeline.MaximumStartTick}"
                 Value="{Binding #Timeline.StartTick, Mode=TwoWay}"
                 ViewportSize="{Binding #Timeline.TickSpan}"
                 SmallChange="120"
                 LargeChange="{Binding #Timeline.TickSpan}" />
    </Grid>
  </Grid>
</UserControl>
