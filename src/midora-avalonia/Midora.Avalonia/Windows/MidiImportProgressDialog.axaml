<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.MidiImportProgressDialog"
        x:CompileBindings="False"
        FontFamily="{DynamicResource Font.UI}"
        Width="560" MinWidth="460"
        SizeToContent="Height"
        Background="{DynamicResource Brush.Surface.0}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,Auto,60">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Background="Transparent" PointerPressed="OnTitlePointerPressed" />
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   IsHitTestVisible="False"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   TextTrimming="CharacterEllipsis" />
        <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCloseClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="18,18,20,18" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="PhaseText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar x:Name="ImportProgress" Grid.Row="1" Height="6" Margin="0,12,0,0"
                     Minimum="0" Maximum="100" Value="0" />
        <TextBlock x:Name="DetailText" Grid.Row="2" Margin="0,8,0,0"
                   Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" />
      </Grid>
      <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button x:Name="CancelButton" Width="112" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
