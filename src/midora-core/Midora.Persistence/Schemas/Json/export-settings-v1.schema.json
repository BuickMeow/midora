{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora settings/export-settings.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "rangeMode",
    "trackSelectionMode",
    "routing",
    "includeReadme",
    "treatWarningsAsErrors"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "mode": { "enum": ["whole-project", "per-logical-track", "per-port"] },
    "rangeMode": { "enum": ["project-default-range", "manual-range"] },
    "manualStartTick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "manualEndTick": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "trackSelectionMode": {
      "enum": ["all-valid-logical-tracks", "explicit-at-task-start"]
    },
    "routing": { "enum": ["compact", "preserve"] },
    "includeReadme": { "type": "boolean" },
    "treatWarningsAsErrors": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "rangeMode": { "const": "manual-range" } } },
      "then": { "required": ["manualStartTick", "manualEndTick"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["manualStartTick"] },
            { "required": ["manualEndTick"] }
          ]
        }
      }
    }
  ]
}
