<Window x:Class="Midora.Desktop.MappingFunctionDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        xmlns:local="clr-namespace:Midora.Desktop"
        Width="720" Height="430" MinWidth="560" MinHeight="360" MaxHeight="760"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="14,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,12" Style="{StaticResource Text.Muted}"
                     Text="Enter one bounded numeric expression. Context dependencies are inferred automatically; Ctrl+Space opens completion."
                     TextWrapping="Wrap"/>
          <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="NAME"/>
          <TextBox x:Name="NameBox" Margin="0,0,0,12" TextChanged="OnInputChanged"/>
          <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="EXPRESSION"/>
          <local:MappingFunctionCodeEditor x:Name="ExpressionEditor"
                                           TextChanged="OnExpressionChanged"
                                           CommitRequested="OnExpressionCommitRequested"/>
          <WrapPanel Margin="0,12,0,10">
            <Button Width="86" Margin="0,0,6,0" Content="Help" Click="OnHelpClick"/>
          </WrapPanel>
          <Border Padding="9,7" Background="{StaticResource Brush.Surface.1}"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="ValidationText" Style="{StaticResource Text.Caption}"
                       Text="Not validated." TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,11" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Width="90" HorizontalAlignment="Left" Content="Validate" Click="OnValidateClick"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,6,0" IsCancel="True" Style="{StaticResource Button.Dialog.Cancel}"
                    Content="Cancel" Click="OnCancelClick"/>
            <Button IsDefault="True" Style="{StaticResource Button.Dialog.Confirm}"
                    Content="OK" Click="OnOkClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
