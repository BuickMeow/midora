              <TextBlock Style="{StaticResource Text.Caption}" Text="Blank means absent. Initial State has no tick." TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Margin="0,0,0,12" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="PLAYBACK"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding PlaybackFields}"/>
            </StackPanel></Border>
            <Border Margin="0,0,0,12" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="MIDI EXPORT DEFAULTS"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding MidiExportFields}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="AUDIO RENDER DEFAULTS"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding AudioRenderFields}"/>
              <TextBlock Margin="0,9,0,4" Style="{StaticResource PropertyLabel}" Text="EXPLICIT LOGICAL TRACKS"/>
              <ListBox MaxHeight="126" ItemsSource="{Binding AudioRenderTracks}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Margin="0,7,0,0" HorizontalAlignment="Left" Content="Apply Explicit Track Selection" Click="OnApplyAudioTrackSelectionClick"/>
            </StackPanel></Border>
            <Border Margin="0,12,0,0" Style="{StaticResource Card}"><StackPanel>
              <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Overline}" Text="PROJECT RESET DEFAULTS"/>
              <ItemsControl ItemTemplate="{StaticResource ProjectSettingFieldTemplate}" ItemsSource="{Binding ResetDefaultFields}"/>
