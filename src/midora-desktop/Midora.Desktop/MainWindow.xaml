      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/><RowDefinition Height="30"/><RowDefinition Height="46"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="BottomPanelSplitterRow" Height="4"/><RowDefinition x:Name="BottomPanelRow" Height="150"/><RowDefinition Height="25"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="{StaticResource Brush.Black}"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
