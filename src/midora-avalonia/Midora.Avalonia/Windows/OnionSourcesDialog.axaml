<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.OnionSourcesDialog"
        x:CompileBindings="False"
        Title="Onion Skin Sources"
        FontFamily="{DynamicResource Font.UI}"
        Width="510" Height="510" MinWidth="420" MinHeight="360"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        KeyDown="OnDialogKeyDown">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,Auto,*,60">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Name="TitleBarDragSurface" Background="Transparent" PointerPressed="OnTitlePointerPressed"/>
        <TextBlock x:Name="TitleText" Margin="12,0,48,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Onion Skin Sources"/>
        <Button HorizontalAlignment="Right" Width="46" Height="36" Classes="caption close"
                Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="14,12">
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="Choose your custom sources. OK enables onion skin and shows these sources instead of the previous/next shortcut."/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Select All" Margin="0,0,6,0" Click="OnSelectAllClick"/>
          <Button Content="Clear" Click="OnClearClick"/>
        </StackPanel>
      </StackPanel>

      <Border Grid.Row="2" Margin="14,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="9,6" IsChecked="{Binding Included, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="4" Height="18" Margin="0,0,9,0" Background="{Binding Color}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}"
                               TextWrapping="Wrap"/>
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="3" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Content="Help" HorizontalAlignment="Left" Click="OnHelpClick"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="112" IsCancel="True" Margin="0,0,6,0" Content="Cancel" Click="OnCancelClick"/>
            <Button Classes="primary" Width="112" IsDefault="True" Content="OK" Click="OnAcceptClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
