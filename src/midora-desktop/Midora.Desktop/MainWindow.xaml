      </Grid>

      <Border Grid.Row="1" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Menu x:Name="MainMenu" Margin="6,0">
          <MenuItem Header="File"><MenuItem Header="New Project…" InputGestureText="Ctrl+N" Click="OnNewProjectClick"/><MenuItem Header="Open Project…" InputGestureText="Ctrl+O" Click="OnOpenProjectClick"/><MenuItem x:Name="RecentProjectsMenu" Header="Open Recent" SubmenuOpened="OnRecentProjectsSubmenuOpened"/><Separator/><MenuItem Header="Save Project" InputGestureText="Ctrl+S" IsEnabled="{Binding CanSaveProject}" Click="OnSaveProjectClick"/><MenuItem Header="Save Copy…" IsEnabled="{Binding CanSaveProject}" Click="OnSaveCopyClick"/><Separator/><MenuItem Header="Close Project" Click="OnCloseProjectClick"/><MenuItem Header="Exit" Click="OnExitClick"/></MenuItem>
          <MenuItem Header="Edit"><MenuItem Header="Undo" InputGestureText="Ctrl+Z" IsEnabled="{Binding CanEditProject}" Click="OnUndoClick"/><MenuItem Header="Redo" InputGestureText="Ctrl+Y" IsEnabled="{Binding CanEditProject}" Click="OnRedoClick"/><Separator/><MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="{Binding CanEditProject}" Click="OnCutClick"/><MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="{Binding HasProject}" Click="OnCopyClick"/><MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="{Binding CanEditProject}" Click="OnPasteClick"/><MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="{Binding HasProject}" Click="OnSelectAllClick"/><MenuItem Header="Duplicate Selection" InputGestureText="Ctrl+D" IsEnabled="{Binding CanEditProject}" Click="OnDuplicateClick"/><Separator/><MenuItem Header="Application Preferences…" IsEnabled="{Binding CanStartForegroundTask}" Click="OnApplicationPreferencesClick"/></MenuItem>
