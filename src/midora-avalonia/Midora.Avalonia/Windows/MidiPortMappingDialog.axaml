<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.MidiPortMappingDialog"
        x:CompileBindings="False"
        FontFamily="{DynamicResource Font.UI}"
        Width="520" MinWidth="440" MaxHeight="640"
        SizeToContent="Height"
        Background="{DynamicResource Brush.Surface.0}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,Auto,60">
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}">
        <Border Background="Transparent" PointerPressed="OnTitlePointerPressed" />
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   IsHitTestVisible="False"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   TextTrimming="CharacterEllipsis" />
        <Button Classes="caption close" HorizontalAlignment="Right" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="18,18,20,18" RowDefinitions="Auto,Auto">
        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap"
                   Text="This MIDI file uses Port values outside Midora's 1-16 range. Map every source Port to one unused Midora Port." />
        <ScrollViewer Grid.Row="1" MaxHeight="400" Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="MappingGrid" ColumnDefinitions="*,16,*" RowDefinitions="Auto" />
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Width="112" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
          <Button Width="112" Margin="6,0,0,0" Classes="primary" Content="Import"
                  IsDefault="True" Click="OnImportClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
