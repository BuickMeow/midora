{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora project.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nextStableId",
    "metadataPath",
    "conductorTrackPath",
    "settings",
    "arrangementParents"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "nextStableId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
    "metadataPath": { "const": "metadata.json" },
    "conductorTrackPath": { "const": "conductor-track.json" },
    "settings": { "$ref": "#/$defs/settingsPaths" },
    "arrangementParents": {
      "type": "array",
      "items": { "$ref": "#/$defs/arrangementParent" }
    }
  },
  "$defs": {
    "settingsPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "export",
        "playback",
        "audioRender",
        "soundFont",
        "globalResetDefaults",
        "globalEventScopeDefaults"
      ],
      "properties": {
        "project": { "const": "settings/project-settings.json" },
        "export": { "const": "settings/export-settings.json" },
        "playback": { "const": "settings/playback-settings.json" },
        "audioRender": { "const": "settings/audio-render-settings.json" },
        "soundFont": { "const": "settings/soundfont-settings.json" },
        "globalResetDefaults": { "const": "settings/global-reset-defaults.json" },
        "globalEventScopeDefaults": { "const": "settings/global-event-scope-defaults.json" }
      }
    },
    "arrangementParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "nameSnapshot", "children"],
      "properties": {
        "kind": { "enum": ["event-instrument", "midi-channel-root"] },
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^(event-instruments/ei_|midi-channel-roots/mcr_)[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/requiredShortText" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/arrangementChild" }
        }
      }
    },
    "arrangementChild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "parentId", "path", "nameSnapshot"],
      "properties": {
        "kind": { "enum": ["logical-track", "pure-midi-track"] },
        "id": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "parentId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "path": {
          "type": "string",
          "pattern": "^(logical-tracks/lt_|midi-tracks/mt_)[1-9][0-9]*\\.pb$"
        },
        "nameSnapshot": { "$ref": "common-v1.schema.json#/$defs/shortText" }
      }
    }
  }
}
