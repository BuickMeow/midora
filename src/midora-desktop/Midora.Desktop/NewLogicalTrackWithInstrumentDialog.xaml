<Window x:Class="Midora.Desktop.NewLogicalTrackWithInstrumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="New Logical Track with Instrument" Width="520" Height="500"
        MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Surface.0}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- The platform ListBox template paints a light disabled background.  This
         dialog deliberately keeps the list surface transparent while disabling
         interaction; opacity alone communicates the inactive source choice. -->
    <Style x:Key="TransparentDisabledListBox"
           TargetType="ListBox"
           BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}"
                    SnapsToDevicePixels="True">
              <ScrollViewer Focusable="False"
                            CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown"><TextBlock Margin="12,0,50,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="New Logical Track with Instrument"/><Button Width="46" Height="38" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" IsCancel="True"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button></Grid>
      <ScrollViewer Grid.Row="1" Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <RadioButton x:Name="NewInstrumentRadio" GroupName="Source" IsChecked="True" Checked="OnSourceChanged" Content="New Event Instrument"/>
          <TextBlock Margin="22,8,0,0" Style="{StaticResource Text.Overline}" Text="INSTRUMENT NAME"/>
          <TextBox x:Name="NewInstrumentNameBox" Margin="22,5,0,16" Text="Event Instrument"/>
          <RadioButton x:Name="ExistingInstrumentRadio" GroupName="Source" Checked="OnSourceChanged" Content="Use Existing Event Instrument"/>
          <ListBox x:Name="ExistingInstrumentList" Margin="22,8,0,0" Height="210"
                   Style="{StaticResource TransparentDisabledListBox}"
                   ItemsSource="{Binding Options}" DisplayMemberPath="Display"
                   MouseDoubleClick="OnOptionsDoubleClick"/>
          <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Width="86" Margin="0,0,6,0" IsCancel="True" Content="Cancel"/><Button Width="86" Style="{StaticResource Button.Primary}" Content="Create" Click="OnCreateClick"/></StackPanel></Border>
    </Grid>
  </Border>
</Window>
