          <MenuItem Header="Help"><MenuItem Header="About Midora" Click="OnAboutClick"/></MenuItem>
        </Menu>
      </Border>

      <Border Grid.Row="2" Padding="9,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
