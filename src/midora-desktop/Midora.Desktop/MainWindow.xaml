                    <StackPanel Margin="8,0,0,8"><TextBlock Style="{StaticResource PropertyLabel}" Text="LONG NOTE STRATEGY"/><ComboBox ItemsSource="{Binding LongLifecycleValues}" SelectedItem="{Binding LongLifecycle, Mode=OneWay}" SelectionChanged="OnInstrumentLifecycleSelectionChanged" Tag="Long"/></StackPanel>
