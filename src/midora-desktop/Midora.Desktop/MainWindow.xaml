                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.75" RepeatBehavior="Forever"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </Grid>
            </Button>
            <ToggleButton Width="34" Height="32" Padding="0" ToolTip="Loop Time Range" IsEnabled="{Binding HasProject}" IsChecked="{Binding IsLoopEnabled, Mode=OneWay}" Click="OnLoopClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.RepeatAll20Regular}"/></ToggleButton>
            <ToggleButton x:Name="FollowPlaybackToggleButton" Width="34" Height="32" Margin="4,0,0,0" Padding="0" ToolTip="Follow Playback" IsEnabled="{Binding HasProject}" Click="OnFollowPlaybackToggleClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowRight20Filled}"/></ToggleButton>
            <Border Height="32" Margin="9,0,0,0" Padding="9,0" Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3"><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Primary}" Style="{StaticResource Text.Mono}" Text="{Binding PositionText}"/><Border Width="1" Height="14" Margin="8,0" Background="{StaticResource Brush.Border.Strong}"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Primary}" Style="{StaticResource Text.Mono}" Text="{Binding TempoText}"/></StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Margin="0,0,4,0" Style="{StaticResource Button.Ghost}" Content="Compile" Click="OnCompileClick" IsEnabled="{Binding CanRunProjectTask}"/>
            <Button Margin="0,0,4,0" Style="{StaticResource Button.Ghost}" Content="MIDI Export" Click="OnMidiExportClick" IsEnabled="{Binding CanRunProjectTask}"/>
            <Button Style="{StaticResource Button.Ghost}" Content="Audio Export" Click="OnAudioRenderClick" IsEnabled="{Binding CanRunProjectTask}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="3" Padding="10,6" Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red.Dark}" BorderThickness="0,0,0,1">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><TextBlock Margin="0,0,34,0" VerticalAlignment="Center" Text="{Binding Notice}" TextWrapping="Wrap"/><Button Width="26" Height="24" HorizontalAlignment="Right" Padding="0" Style="{StaticResource Button.Ghost}" ToolTip="Dismiss notice" Click="OnDismissNoticeClick"><ui:FluentIcon Width="12" Height="12" Data="{StaticResource Fluent.Dismiss20Regular}"/></Button></Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProjectPanelColumn" Width="0" MinWidth="0"/><ColumnDefinition x:Name="ProjectSplitterColumn" Width="0"/><ColumnDefinition Width="*" MinWidth="500"/><ColumnDefinition x:Name="InspectorSplitterColumn" Width="4"/><ColumnDefinition x:Name="InspectorColumn" Width="270" MinWidth="220" MaxWidth="420"/></Grid.ColumnDefinitions>
        <Grid x:Name="ProjectPanelGrid" Visibility="Collapsed" Background="{StaticResource Brush.Surface.1}">
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource PanelHeader}"><Grid><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Project"/><ToggleButton x:Name="NewProjectItemButton" Width="26" Height="24" HorizontalAlignment="Right" Padding="0" AutomationProperties.Name="New Project item" ToolTip="New Project item" IsChecked="{Binding IsOpen, ElementName=NewProjectItemPopup, Mode=TwoWay}"><ui:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.Add20Regular}"/></ToggleButton><Popup x:Name="NewProjectItemPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=NewProjectItemButton}" StaysOpen="False" AllowsTransparency="True"><Border MinWidth="230" Padding="4" Background="{StaticResource Brush.Surface.2}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}"><StackPanel><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style></StackPanel.Resources><Button Content="New Logical Track" Click="OnNewTrackClick"/><Button Content="New Event Instrument" Click="OnNewInstrumentClick"/></StackPanel></Border></Popup></Grid></Border>
          <TextBox Grid.Row="1" Margin="7,7,7,3" ToolTip="Filter Event Instruments, folders, Logical Tracks, and last known instrument names" Text="{Binding ProjectTreeSearchText, UpdateSourceTrigger=PropertyChanged}"/>
          <TreeView x:Name="ProjectTree" Grid.Row="2" Padding="6" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Project navigation"
                    ItemsSource="{Binding ProjectTree}" ItemContainerStyle="{StaticResource TreeItemStyle}"
                    AllowDrop="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseDoubleClick="OnProjectTreeDoubleClick" PreviewKeyDown="OnProjectTreeKeyDown"
                    PreviewMouseLeftButtonDown="OnProjectTreeLeftButtonDown"
                    PreviewMouseMove="OnProjectTreeMouseMove"
                     DragOver="OnProjectTreeDragOver" Drop="OnProjectTreeDrop"
                     PreviewMouseRightButtonDown="OnProjectTreeRightButtonDown">
            <TreeView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding CanUseContextMenus}" Opened="OnProjectTreeContextMenuOpened">
                <MenuItem Header="Open" Click="OnTreeOpenClick"/>
                <MenuItem Header="Rename" InputGestureText="F2" Click="OnTreeRenameClick"/>
                <MenuItem Header="Bind Event Instrument…" Click="OnTreeBindInstrumentClick"/>
                <Separator/>
                <MenuItem Header="Move Up" Click="OnTreeMoveUpClick"/>
                <MenuItem Header="Move Down" Click="OnTreeMoveDownClick"/>
                <Separator/>
                <MenuItem Header="Delete…" Click="OnTreeDeleteClick"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </Grid>
        <GridSplitter x:Name="ProjectPanelSplitter" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2">
          <TabControl x:Name="WorkspaceTabs" Style="{StaticResource SingleLineWorkspaceTabs}" ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Workspaces" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
                      SelectionChanged="OnWorkspaceTabsSelectionChanged"
                      AllowDrop="True" PreviewMouseLeftButtonDown="OnWorkspaceTabsLeftButtonDown" PreviewMouseMove="OnWorkspaceTabsMouseMove" DragOver="OnWorkspaceTabsDragOver" Drop="OnWorkspaceTabsDrop">
            <TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><StackPanel.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Close" IsEnabled="{Binding CanClose}" Click="OnCloseWorkspaceClick"/><MenuItem Header="Close Other Workspaces" Click="OnCloseOtherWorkspacesClick"/></ContextMenu></StackPanel.ContextMenu><ui:FluentIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Icon.Stepper}" Data="{Binding TabIconKind, Converter={StaticResource WorkspaceTabIconConverter}}"/><TextBlock VerticalAlignment="Center" Text="{Binding Header}"/><Button Width="20" Height="20" Margin="7,0,0,0" Padding="0" Style="{StaticResource Button.Ghost}" ToolTip="Close Workspace" Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibility}}" Click="OnCloseWorkspaceClick"><ui:FluentIcon Width="10" Height="10" Data="{StaticResource Fluent.Dismiss20Regular}"/></Button></StackPanel></DataTemplate></TabControl.ItemTemplate>
          </TabControl>
          <Border x:Name="EmptyState" Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
            <StackPanel Width="360"><TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" Text="Midora"/><TextBlock Margin="0,8,0,18" HorizontalAlignment="Center" Style="{StaticResource Text.Muted}" Text="Open an existing Project or create a new one."/><StackPanel HorizontalAlignment="Center" Orientation="Horizontal"><Button Margin="0,0,7,0" Style="{StaticResource Button.Primary}" Content="New Project" Click="OnNewProjectClick"/><Button Content="Open Project" Click="OnOpenProjectClick"/></StackPanel></StackPanel>
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
          </Border>
        </Grid>
        <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" HorizontalAlignment="Stretch"/>
        <Grid x:Name="InspectorGrid" Grid.Column="4" Background="{StaticResource Brush.Surface.1}">
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource PanelHeader}"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Inspector"/></Border>
          <ScrollViewer Grid.Row="1" Padding="11" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding Inspector}">
              <TextBlock Style="{StaticResource Text.Section}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Margin="0,3,0,13" Style="{StaticResource Text.Caption}" Text="{Binding Context}" TextWrapping="Wrap"/>
              <Border Margin="0,0,0,10" Padding="8" Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red}" BorderThickness="1" CornerRadius="3">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Foreground="{StaticResource Brush.Red.Hover}" Text="{Binding ErrorText}" TextWrapping="Wrap"/>
              </Border>
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                      <TextBlock Style="{StaticResource PropertyLabel}" Text="{Binding Label}"/>
                      <Grid>
                      <TextBox Tag="{Binding}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                               LostKeyboardFocus="OnInspectorFieldLostKeyboardFocus"
                               KeyDown="OnInspectorFieldKeyDown">
                        <TextBox.Style>
                          <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="IsReadOnly" Value="True"/>
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding ValueState}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsReadOnly" Value="False"/></MultiDataTrigger>
                              <DataTrigger Binding="{Binding IsMixed}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/><Setter Property="FontStyle" Value="Italic"/></DataTrigger>
                              <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/><Setter Property="FontStyle" Value="Italic"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <ComboBox Tag="{Binding}" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="OnInspectorChoiceDropDownClosed">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsChoice}" Value="True"/><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></ComboBox.Style>
                      </ComboBox>
                      <CheckBox Tag="{Binding}" Content="Enabled" IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="OnInspectorBooleanClick">
                        <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBoolean}" Value="True"/><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></CheckBox.Style>
                      </CheckBox>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
      <TabControl x:Name="BottomTabs" Grid.Row="6" Background="{StaticResource Brush.Surface.1}">
        <TabItem Header="Diagnostics">
          <Grid DataContext="{Binding BottomDiagnosticsViewModel}">
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="5,3"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ComboBox Height="24" Margin="0,0,5,0" VerticalAlignment="Center" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" ToolTip="Severity filter"/>
              <ComboBox Grid.Column="1" Height="24" Margin="0,0,5,0" VerticalAlignment="Center" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" ToolTip="Activity filter"/>
              <ComboBox Grid.Column="2" Height="24" Margin="0,0,5,0" VerticalAlignment="Center" ItemsSource="{Binding ScopeFilters}" SelectedItem="{Binding ScopeFilter}" ToolTip="Scope filter"/>
              <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Summary}"/>
            </Grid>
            <ListBox x:Name="BottomDiagnosticsList" Grid.Row="1" ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding DataContext.SelectedBottomDiagnostic, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" MouseDoubleClick="OnDiagnosticDoubleClick" ContextMenu="{StaticResource DiagnosticContextMenu}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="85"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Foreground="{StaticResource Brush.Red.Hover}" Text="{Binding Severity}"/><TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" Text="{Binding Code}"/><TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding Status}"/><TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" Text="{Binding Source}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </Grid>
        </TabItem>
        <TabItem Header="Details"><Grid Margin="12" DataContext="{Binding SelectedBottomDiagnostic}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource PropertyLabel}" Text="SEVERITY"/><TextBlock Text="{Binding Severity, TargetNullValue=No diagnostic selected}"/><TextBlock Margin="0,10,0,0" Style="{StaticResource PropertyLabel}" Text="CODE"/><TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Code}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource PropertyLabel}" Text="MESSAGE"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Margin="0,10,0,0" Style="{StaticResource PropertyLabel}" Text="SOURCE"/><TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Source}"/></StackPanel></Grid></TabItem>
        <TabItem Header="Tasks">
          <Grid>
            <ListBox ItemsSource="{Binding TaskHistory}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4,2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/><ProgressBar Grid.Column="3" Height="6" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter Property="IsIndeterminate" Value="False"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><Button Grid.Column="4" Height="24" Padding="5,0" Content="Cancel" IsEnabled="{Binding CanRequestCancel}" Tag="{Binding}" Click="OnCancelTaskClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="No tasks in this Project session">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TaskHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </TabItem>
      </TabControl>

      <Border Grid.Row="7" Padding="9,0" Background="{StaticResource Brush.Black}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0" ToolTip="{Binding IssueSummary}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Fill" Value="{StaticResource Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Fill" Value="{StaticResource Brush.Red}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Background="Transparent"
                       Cursor="Hand"
                       Text="{Binding IssueSummary}"
                       ToolTip="Open Diagnostics"
                       AutomationProperties.Name="Open Diagnostics"
                       MouseLeftButtonUp="OnDiagnosticSummaryMouseLeftButtonUp">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CompileState}"/>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SoundFontState}"/>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ProjectState}"/>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Text="{Binding PlaybackStatusText}">
              <TextBlock.Style>
                 <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                   <Style.Triggers>
                     <DataTrigger Binding="{Binding IsPlaybackActive}" Value="True">
                       <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                     </DataTrigger>
                     <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                      <Setter Property="Foreground" Value="#FFFFC400"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock MaxWidth="520" VerticalAlignment="Center" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/><Style.Triggers><DataTrigger Binding="{Binding StatusMessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Height="20" Margin="7,0,0,0" Padding="6,0" Content="Details" Click="OnStatusMessageDetailsClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasStatusMessage}" Value="True"/><Condition Binding="{Binding StatusMessageIsError}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Height="20" Margin="7,0,0,0" Padding="6,0" Content="Dismiss" Click="OnDismissStatusMessageClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStatusMessage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="TaskLockOverlay" Grid.RowSpan="8" Panel.ZIndex="1000" Focusable="True"
              Background="#D9101216" IsHitTestVisible="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMainWindowTaskLocked}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="4">
          <StackPanel DataContext="{Binding ActiveForegroundTask}">
            <TextBlock Style="{StaticResource Text.Overline}" Text="MIDORA TASK"/>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{Binding Name}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" TextWrapping="Wrap"/>
            <ProgressBar Height="7" Margin="0,18,0,0" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource TaskProgressBar}">
                  <Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <Grid Margin="0,16,0,0">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanCancel}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Button x:Name="TaskLockCancelButton" MinWidth="92" HorizontalAlignment="Right" Content="Cancel"
                      IsEnabled="{Binding CanRequestCancel}" Tag="{Binding}" Click="OnCancelTaskClick"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
