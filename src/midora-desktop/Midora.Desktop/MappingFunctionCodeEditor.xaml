<UserControl x:Class="Midora.Desktop.MappingFunctionCodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             MinHeight="42"
             FontFamily="{StaticResource Font.Mono}"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
  <Grid>
    <Border MinHeight="42"
            Background="{StaticResource Brush.Surface.0}"
            BorderThickness="1"
            CornerRadius="3">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <avalonEdit:TextEditor x:Name="CodeEditor"
                             MinHeight="40"
                             Padding="6,4"
                             Background="Transparent"
                             Foreground="#D4D4D4"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="12"
                             ShowLineNumbers="False"
                             LineNumbersForeground="{StaticResource Brush.Text.Tertiary}"
                             WordWrap="True"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Disabled"
                             PreviewKeyDown="OnEditorPreviewKeyDown"
                             PreviewTextInput="OnEditorPreviewTextInput"
                             TextChanged="OnEditorTextChanged"
                             LostKeyboardFocus="OnEditorLostKeyboardFocus"/>
    </Border>

    <Popup x:Name="CompletionPopup"
           PlacementTarget="{Binding ElementName=CodeEditor}"
           Placement="Relative"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None">
      <Border MinWidth="500"
              MaxWidth="800"
              MaxHeight="320"
              Background="{StaticResource Brush.Surface.2}"
              BorderBrush="{StaticResource Brush.Border.Strong}"
              BorderThickness="1"
              CornerRadius="4">
        <DockPanel LastChildFill="True">
          <Border x:Name="SignaturePanel"
                  DockPanel.Dock="Bottom"
                  Padding="8,6"
                  Background="{StaticResource Brush.Surface.0}"
                  BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="0,1,0,0"
                  Visibility="Collapsed">
            <TextBlock x:Name="SignatureText"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="11"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap"/>
          </Border>
          <ListBox x:Name="CompletionList"
                   Focusable="False"
                   MaxHeight="245"
                   Background="{StaticResource Brush.Surface.2}"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   PreviewMouseWheel="OnCompletionListPreviewMouseWheel"
                   SelectionChanged="OnCompletionSelectionChanged"
                   PreviewMouseLeftButtonDown="OnCompletionMouseLeftButtonDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock FontFamily="{StaticResource Font.Mono}"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             Text="{Binding Text}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1"
                             Margin="8,0"
                             Foreground="{StaticResource Brush.Info}"
                             Text="{Binding Kind}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2"
                             Foreground="{StaticResource Brush.Text.Tertiary}"
                             Text="{Binding Description}"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
