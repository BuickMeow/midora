{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora settings/audio-render-settings.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "rangeMode",
    "trackSelectionMode",
    "explicitLogicalTrackIds",
    "container",
    "channelLayout",
    "sampleFormat",
    "endianness",
    "sampleRate",
    "maximumSampleVoicesPerStream",
    "trackFileNamePattern"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "mode": { "enum": ["whole-mix", "per-logical-track"] },
    "rangeMode": { "enum": ["project-default-range", "manual-range"] },
    "manualStartTick": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "manualEndTick": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "trackSelectionMode": {
      "enum": ["all-valid-logical-tracks", "explicit-logical-track-ids"]
    },
    "explicitLogicalTrackIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common-v1.schema.json#/$defs/stableId" }
    },
    "container": { "const": "riff-wave" },
    "channelLayout": { "const": "stereo" },
    "sampleFormat": { "const": "interleaved-ieee-float32" },
    "endianness": { "const": "little-endian" },
    "sampleRate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "maximumSampleVoicesPerStream": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "trackFileNamePattern": { "const": "project-order-number-and-track-name" }
  },
  "allOf": [
    {
      "if": { "properties": { "rangeMode": { "const": "manual-range" } } },
      "then": { "required": ["manualStartTick", "manualEndTick"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["manualStartTick"] },
            { "required": ["manualEndTick"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "trackSelectionMode": { "const": "all-valid-logical-tracks" } }
      },
      "then": { "properties": { "explicitLogicalTrackIds": { "maxItems": 0 } } }
    }
  ]
}
