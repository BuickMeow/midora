<Application x:Class="Midora.Desktop.StyleGallery.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Midora.Desktop.Presentation;component/Themes/Palette.xaml" />
        <ResourceDictionary Source="/Midora.Desktop.Presentation;component/Themes/FluentSystemIcons.xaml" />
        <ResourceDictionary Source="/Midora.Desktop.Presentation;component/Themes/WindowControlIcons.xaml" />
        <ResourceDictionary Source="/Midora.Desktop.Presentation;component/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
