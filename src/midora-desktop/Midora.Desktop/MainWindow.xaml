        <StackPanel Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Caption}" ToolTip="Minimize" Click="OnMinimizeClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl.Minimize}" Data="{StaticResource WindowControl.Minimize}"/></Button>
          <Button Style="{StaticResource Button.Caption}" ToolTip="Maximize or restore" Click="OnMaximizeClick"><ui:FluentIcon x:Name="MaximizeGlyph" Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Maximize}"/></Button>
          <Button Style="{StaticResource Button.Caption.Close}" ToolTip="Close" Click="OnCloseClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button>
