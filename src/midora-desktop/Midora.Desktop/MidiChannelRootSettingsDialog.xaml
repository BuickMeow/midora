<Window x:Class="Midora.Desktop.MidiChannelRootSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="MIDI Route Settings"
        Width="470" Height="420" MinWidth="430" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        ShowInTaskbar="False" Background="{StaticResource Brush.Surface.0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="12,0,50,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="MIDI Route Settings" TextTrimming="CharacterEllipsis"/>
        <Button Width="46" Height="38" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Overline}" Text="ROUTING MODE"/>
          <ComboBox x:Name="RoutingModeBox" Margin="0,5,0,14"
                    SelectionChanged="OnRoutingModeChanged"/>

          <Grid x:Name="FixedRoutePanel" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Overline}" Text="PORT"/>
              <ComboBox x:Name="PortBox" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Style="{StaticResource Text.Overline}" Text="CHANNEL"/>
              <ComboBox x:Name="ChannelBox" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>

          <TextBlock Style="{StaticResource Text.Overline}" Text="CHANNEL MODE"/>
          <ComboBox x:Name="ChannelModeBox" Margin="0,5,0,0"/>
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                     Text="This is a Track route property. Tracks assigned to the same Fixed Port.Channel share one MIDI Channel state. Independent Auto Tracks receive an automatically allocated Unit." TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" MinHeight="58" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,6,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel"/>
          <Button Style="{StaticResource Button.Dialog.Confirm}" Content="Apply" Click="OnApplyClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
