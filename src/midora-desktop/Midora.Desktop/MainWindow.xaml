            </StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:DiagnosticsWorkspaceViewModel}">
      <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="26"/><RowDefinition Height="116"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="145"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
        <TextBox Margin="0,0,6,0" ToolTip="Search severity, category, code, message, or source" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SeverityFilter}" ToolTip="Severity filter"/>
        <ComboBox Grid.Column="2" Margin="0,0,6,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" ToolTip="Activity filter"/>
        <ComboBox Grid.Column="3" ItemsSource="{Binding ScopeFilters}" SelectedItem="{Binding ScopeFilter}" ToolTip="Scope filter"/>
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding DataContext.SelectedDiagnostic, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" MouseDoubleClick="OnDiagnosticDoubleClick" ContextMenu="{StaticResource DiagnosticContextMenu}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="90"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
            <TextBlock Foreground="{StaticResource Brush.Red.Hover}" Text="{Binding Severity}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}" Text="{Binding Code}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{Binding Status}" />
            <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
          </Grid></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Diagnostics.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Section}" Text="No diagnostics"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="Compile the Project or clear the current search."/></StackPanel></Border>
      <Border Grid.Row="2" Padding="8,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1"><TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Summary}"/></Border>
      <Border Grid.Row="3" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid DataContext="{Binding DataContext.SelectedDiagnostic, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock FontWeight="SemiBold" Text="{Binding Code, TargetNullValue=Diagnostic details}"/><TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}"><Run Text="{Binding Category}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></Grid>
          <Grid Grid.Row="1" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message, TargetNullValue=Select a diagnostic to inspect its details.}" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Style="{StaticResource Text.Overline}" Text="SOURCE PATH"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Source}" TextWrapping="Wrap"/></StackPanel></Grid>
        </Grid>
      </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="WindowFrame">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/><Setter Property="BorderThickness" Value="1"/>
