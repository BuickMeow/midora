<Window x:Class="Midora.Desktop.BatchEditDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Width="620" Height="570" MinWidth="520" MinHeight="430" MaxHeight="760"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Batch Edit Selection"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="14,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,12" Style="{StaticResource Text.Muted}"
                     Text="Leave a field blank to keep it unchanged. Values use invariant decimal notation. Expressions are evaluated for each selected object."
                     TextWrapping="Wrap"/>
          <Grid x:Name="VelocityRow" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Velocity"/>
            <TextBox x:Name="VelocityBox" Grid.Column="1" Height="Auto" MinHeight="32" Padding="7,5" AcceptsReturn="False"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" TextChanged="OnFormulaTextChanged"/>
          </Grid>
          <Grid x:Name="PointValueRow" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Point Value"/>
            <TextBox x:Name="PointValueBox" Grid.Column="1" Height="Auto" MinHeight="32" Padding="7,5" AcceptsReturn="False"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" TextChanged="OnFormulaTextChanged"/>
          </Grid>
          <Grid x:Name="KeyNumberRow" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Key Number"/>
            <TextBox x:Name="KeyNumberBox" Grid.Column="1" Height="Auto" MinHeight="32" Padding="7,5" AcceptsReturn="False"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" TextChanged="OnFormulaTextChanged"/>
          </Grid>
          <Grid x:Name="GateRow" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Gate"/>
            <TextBox x:Name="GateBox" Grid.Column="1" Height="Auto" MinHeight="32" Padding="7,5" AcceptsReturn="False"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" TextChanged="OnFormulaTextChanged"/>
          </Grid>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" Margin="0,7,10,0" Text="Tick"/>
            <TextBox x:Name="TickBox" Grid.Column="1" Height="Auto" MinHeight="32" Padding="7,5" AcceptsReturn="False"
                     VerticalContentAlignment="Top" FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" TextChanged="OnFormulaTextChanged"/>
          </Grid>
          <WrapPanel Margin="116,0,0,10">
            <Button Width="86" Margin="0,0,6,6" Content="Help" Click="OnHelpClick"/>
            <Button Width="96" Margin="0,0,6,6" Content="Presets…" Click="OnPresetsClick"/>
            <Button Width="112" Margin="0,0,6,6" Content="Save Preset…" Click="OnSavePresetClick"/>
          </WrapPanel>
          <Border Padding="9,7" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="ValidationText" Style="{StaticResource Text.Caption}" Text="Not validated." TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,11" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Width="90" HorizontalAlignment="Left" Content="Validate" Click="OnValidateClick"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,6,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/>
            <Button Style="{StaticResource Button.Dialog.Confirm}" Content="Apply" Click="OnApplyClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
