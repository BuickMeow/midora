          <Border Width="1" Height="12" Margin="10,0" Background="{StaticResource Brush.Border.Strong}"/>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding TitleBarProjectDisplayName}"/>
