<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Midora.Avalonia.Controls"
        x:Class="Midora.Avalonia.Windows.QuantizeSelectionDialog"
        x:CompileBindings="False"
        Title="Quantize Selection"
        Width="520" Height="315" MinWidth="470" MinHeight="285"
        FontFamily="{DynamicResource Font.UI}"
        Background="{DynamicResource Brush.Surface.0}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome">
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
    <Grid RowDefinitions="36,*,62">

      <!-- Title bar: self-drawn caption with drag and close. -->
      <Grid Grid.Row="0" Background="{DynamicResource Brush.Black}" PointerPressed="OnTitlePointerPressed">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Quantize Selection" TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="36" HorizontalAlignment="Right" Classes="caption close"
                ToolTip.Tip="Close" Click="OnCancelClick">
          <controls:FluentIcon Classes="captionicon" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="16,14">
        <TextBlock Margin="0,0,0,14" Classes="muted" TextWrapping="Wrap"
                   Text="Move selected objects to the nearest grid point. Exact halfway values move to the earlier grid point." />

        <Grid Margin="0,0,0,11" ColumnDefinitions="130,*">
          <TextBlock VerticalAlignment="Center" Text="Grid" />
          <ComboBox x:Name="GridBox" Grid.Column="1" SelectionChanged="OnGridChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid x:Name="CustomTicksRow" Margin="0,0,0,11" ColumnDefinitions="130,*,48" IsVisible="False">
          <TextBlock VerticalAlignment="Center" Text="Custom Grid" />
          <TextBox x:Name="CustomTicksBox" Grid.Column="1" Text="1" TextChanged="OnInputChanged" />
          <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="Ticks" />
        </Grid>

        <Grid x:Name="NoteModeRow" ColumnDefinitions="130,*">
          <TextBlock VerticalAlignment="Center" Text="Note Boundaries" />
          <ComboBox x:Name="NoteModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnInputSelectionChanged">
            <ComboBoxItem Content="Start Only" />
            <ComboBoxItem Content="Start and End" />
          </ComboBox>
        </Grid>

        <TextBlock x:Name="ValidationText" Margin="130,10,0,0" Classes="caption"
                   Foreground="{DynamicResource Brush.Red.Hover}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Width="112" Margin="0,0,6,0" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
          <Button Classes="primary" Width="112" Content="Apply" IsDefault="True" Click="OnApplyClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
