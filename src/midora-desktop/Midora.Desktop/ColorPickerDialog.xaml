<Window x:Class="Midora.Desktop.ColorPickerDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Select Color" Width="620" Height="390" MinWidth="620" MinHeight="390"
        MaxWidth="620" MaxHeight="390" ResizeMode="NoResize"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Select Color"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button>
      </Grid>
      <Grid Grid.Row="1" Margin="16,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="44"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Canvas Grid.Column="0" Width="220" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top"
                MouseLeftButtonDown="OnWheelMouseLeftButtonDown" MouseLeftButtonUp="OnWheelMouseLeftButtonUp" MouseMove="OnWheelMouseMove">
          <Border Width="224" Height="224" Margin="-2" Background="{StaticResource Brush.Surface.1}" CornerRadius="112"/>
          <Image x:Name="ColorWheelImage" Width="220" Height="220" Stretch="None"/>
          <Ellipse x:Name="WheelSelector" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
        </Canvas>
        <Canvas Grid.Column="1" Width="30" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top"
                MouseLeftButtonDown="OnBrightnessMouseLeftButtonDown" MouseLeftButtonUp="OnBrightnessMouseLeftButtonUp" MouseMove="OnBrightnessMouseMove">
          <Border Width="30" Height="220" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"/>
          <Image x:Name="BrightnessImage" Width="28" Height="218" Canvas.Left="1" Canvas.Top="1" Stretch="None"/>
          <Border x:Name="BrightnessSelector" Width="36" Height="3" Canvas.Left="-3" Background="White" IsHitTestVisible="False"/>
        </Canvas>
        <Grid Grid.Column="3" VerticalAlignment="Top">
          <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="72"/><ColumnDefinition Width="16"/><ColumnDefinition Width="26"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,8" VerticalAlignment="Center" Text="R"/><TextBox x:Name="RedTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextChanged="OnRgbTextChanged"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,6,8" VerticalAlignment="Center" Text="G"/><TextBox x:Name="GreenTextBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" TextChanged="OnRgbTextChanged"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,8" VerticalAlignment="Center" Text="B"/><TextBox x:Name="BlueTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="OnRgbTextChanged"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,8" VerticalAlignment="Center" Text="#"/><TextBox x:Name="HexTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,8" TextChanged="OnHexTextChanged"/>
          <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Margin="0,0,0,10" Style="{StaticResource Text.Caption}" Text="Format: #RRGGBB"/>
          <Border Grid.Row="4" Grid.ColumnSpan="5" Height="68" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" Background="{StaticResource Brush.Surface.1}"><Rectangle x:Name="PreviewFill" Margin="5"/></Border>
          <TextBlock x:Name="ErrorTextBlock" Grid.Row="5" Grid.ColumnSpan="5" Margin="0,8,0,0" Foreground="{StaticResource Brush.Red}" TextWrapping="Wrap"/>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button Margin="0,0,6,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/><Button Style="{StaticResource Button.Dialog.Confirm}" Content="Select" Click="OnAcceptClick"/></StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
