          <Grid Width="18" Height="18" Margin="0,0,9,0"><Border Width="5" Height="18" HorizontalAlignment="Left" Background="{StaticResource Brush.Red}"/><Border Width="5" Height="12" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource Brush.Red.Dark}"/><Border Width="5" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource Brush.Text.Tertiary}"/></Grid>
