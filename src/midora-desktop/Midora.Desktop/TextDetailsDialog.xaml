<Window x:Class="Midora.Desktop.TextDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Width="720" Height="420" MinWidth="480" MinHeight="280"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="11,0,44,0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                   TextTrimming="CharacterEllipsis" />
        <Button Width="46" Height="36" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}"
                Click="OnCloseClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}"
                         Data="{StaticResource WindowControl.Close}" />
        </Button>
      </Grid>
      <TextBox x:Name="MessageTextBox"
               Grid.Row="1"
               Height="Auto"
               Margin="12"
               Padding="10"
               AcceptsReturn="True"
               FontFamily="Consolas"
               IsReadOnly="True"
               TextWrapping="NoWrap"
               VerticalContentAlignment="Top"
               HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto" />
      <Border Grid.Row="2" Padding="12,10"
              Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button x:Name="CopyButton" Width="84" Margin="0,0,6,0"
                  Content="Copy" Click="OnCopyClick" />
          <Button Width="84" Style="{StaticResource Button.Primary}"
                  Content="Close" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
