<Window x:Class="Midora.Desktop.AudioRenderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Render Audio" Width="670" Height="620" MinWidth="610" MinHeight="550"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface.0}" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown"><TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Render Audio"/><Button Width="46" Height="38" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button></Grid>
      <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Overline}" Text="OUTPUT"/>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="MODE"/>
          <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged"/>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="TARGET FILE / DIRECTORY"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputPathBox" IsReadOnly="True"/><Button Grid.Column="1" Width="78" Margin="6,0,0,0" Content="Browse…" Click="OnBrowseClick"/></Grid>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="SAMPLE RATE (HZ)"/>
          <TextBox x:Name="SampleRateBox"/>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="MAXIMUM SAMPLE VOICES / UNIT STREAM"/>
          <TextBox x:Name="VoicesBox"/>
          <CheckBox x:Name="WarningsCheck" Margin="0,14,0,0" Content="Treat compiler warnings as errors"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource Text.Overline}" Text="RANGE"/>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="START TICK"/>
          <TextBox x:Name="StartTickBox" Text="0"/>
          <TextBlock Margin="0,10,0,4" Style="{StaticResource Text.Caption}" Text="END TICK (EMPTY = PROJECT / NATURAL END)"/>
          <TextBox x:Name="EndTickBox"/>
          <Border Margin="0,16,0,0" Style="{StaticResource Card}"><StackPanel><TextBlock FontWeight="SemiBold" Text="Formal render chain"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="Canonical compiled result → isolated win-x64 Native AOT audio worker → per-Port sum → Playback Master Volume → Limiter → atomic float32 WAVE publication. At least one enabled application SoundFont and the pinned worker/native baseline are required." TextWrapping="Wrap"/></StackPanel></Border>
          <CheckBox x:Name="SelectedTracksCheck" Margin="0,14,0,5" Content="Use only the checked Tracks"/>
          <ListBox MaxHeight="145" ItemsSource="{Binding TrackRows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock x:Name="ValidationText" Margin="0,12,0,0" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,7,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/><Button Style="{StaticResource Button.Dialog.Confirm}" Content="Review Plan" Click="OnReviewClick"/></StackPanel></Border>
    </Grid>
  </Border>
</Window>
